# KiCad 10.0.7 for the browser: the cache KiCad's own CMake is configured with (build-gui.sh: -C this file, after the
# slicers' initial-cache.cmake). Options off: tests, tools, the Python shell window, the IPC server, desktop-only pieces.
# Paths: the libraries built by build-kdeps.sh, build-occt.sh, build-python.sh, build-wx.sh; the tab is laid out as a Linux
# install under /kicad (kicad-pre.js).
set(KDEPS "/w/prefix-kdeps" CACHE PATH "the KiCad-only libraries (build-kdeps.sh)")
set(SPIKE_GUI "/w/spike/gui" CACHE PATH "this folder")
set(KICAD_SRC "/w/kicad" CACHE PATH "KiCad 10.0.7 source (with spike/patches/kicad-wasm.patch)")
set(WX_PREFIX "/w/prefix-wx" CACHE PATH "wasm wx prefix")
set(WX_SRC "/w/pwx" CACHE PATH "wasm wx source (its build/wasm page template and wx.js)")
set(KICAD_WX_PORT wasm CACHE STRING "" FORCE)
set(CMAKE_INSTALL_PREFIX "/kicad" CACHE PATH "" FORCE)
set(KICAD_CONFIG_DIR "kicad" CACHE STRING "" FORCE)
set(OCC_INCLUDE_DIR "/w/prefix-occt/include/opencascade" CACHE PATH "" FORCE)
set(OCC_LIBRARY_DIR "/w/prefix-occt/lib" CACHE PATH "" FORCE)
set(NGSPICE_ROOT_DIR "${KDEPS}" CACHE PATH "" FORCE)
set(SPNAV_INCLUDE_DIR "${KDEPS}/include" CACHE PATH "" FORCE)
set(SPNAV_LIBRARY "${KDEPS}/lib/libspnav.a" CACHE FILEPATH "" FORCE)
set(Protobuf_PROTOC_EXECUTABLE "${SPIKE_GUI}/protoc-wrap.sh" CACHE FILEPATH "the image's protoc, the same release as the wasm libprotobuf" FORCE)
set(PYTHON_EXECUTABLE "/usr/bin/python3" CACHE FILEPATH "" FORCE)
set(PYTHON_LIBRARY "/w/prefix-py/lib/libpython3.12.a" CACHE FILEPATH "" FORCE)
set(PYTHON_INCLUDE_DIR "/w/prefix-py/include/python3.12" CACHE PATH "" FORCE)
set(PYTHON_SITE_PACKAGE_PATH "lib/python3.12/site-packages" CACHE STRING "" FORCE)
set(SWIG_EXECUTABLE "/usr/bin/swig" CACHE FILEPATH "" FORCE)
set(UnixODBC_INCLUDE_DIR "${KDEPS}/include" CACHE PATH "" FORCE)
set(KICAD_SCRIPTING_WXPYTHON OFF CACHE BOOL "" FORCE)
set(KICAD_BUILD_QA_TESTS OFF CACHE BOOL "" FORCE)
set(KICAD_SPICE_QA OFF CACHE BOOL "" FORCE)
set(KICAD_IPC_API ON CACHE BOOL "the plug-in manager code assumes it; the server stays off in a tab (nng built for wasm)" FORCE)
set(KICAD_WAYLAND OFF CACHE BOOL "" FORCE)
set(KICAD_USE_SENTRY OFF CACHE BOOL "" FORCE)
set(KICAD_BUILD_I18N OFF CACHE BOOL "" FORCE)
set(KICAD_IDF_TOOLS ON CACHE BOOL "pcbnew links the idf3 library, which only this option builds (the four idf tools themselves are not built)" FORCE)
set(KICAD_INSTALL_DEMOS OFF CACHE BOOL "" FORCE)
set(KICAD_USE_PCH OFF CACHE BOOL "" FORCE)
set(KICAD_SIGNAL_INTEGRITY OFF CACHE BOOL "" FORCE)
set(KICAD_DRC_PROTO OFF CACHE BOOL "" FORCE)
set(KICAD_BUILD_PNS_DEBUG_TOOL OFF CACHE BOOL "" FORCE)
set(KICAD_BUILD_PEGTL_DEBUG_TOOL OFF CACHE BOOL "" FORCE)
set(KICAD_UPDATE_CHECK OFF CACHE BOOL "" FORCE)
set(Protobuf_INCLUDE_DIR "${KDEPS}/include" CACHE PATH "protoc's import path for google/protobuf/*.proto" FORCE)
set(NANODBC_ENABLE_UNICODE OFF CACHE BOOL "libc++ (LLVM 19+) has no char_traits<unsigned short>; KiCad's code is written for either string type" FORCE)
set(KICAD_WASM_LIBCONTEXT "${SPIKE_GUI}/stubs/libcontext_threads.cpp" CACHE FILEPATH "coroutine contexts as threads" FORCE)
set(KICAD_WASM_HOST_LEMON "/w/kgui-host/lemon" CACHE FILEPATH "the lemon parser generator built for the host (build-gui.sh)" FORCE)
