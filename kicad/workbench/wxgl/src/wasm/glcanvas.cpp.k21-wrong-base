// The <canvas> lives inside the top-level window's div (wx.js windowMap), on
// top of the 2D canvas wxUniversal draws into, and takes no pointer events:
// the main canvas keeps receiving them and wx routes them to the GL window.
EM_JS(int, wxglCreateElement, (int windowId), {
    if (typeof Module.wxglNextId === 'undefined') Module.wxglNextId = 1;
    var id = Module.wxglNextId++;
    var c = document.createElement('canvas');
    c.id = 'wxgl-' + id;
    c.style.position = 'absolute';
    c.style.pointerEvents = 'none';
    c.style.zIndex = 5;
    c.style.display = 'none';
    var host = windowMap.get(windowId).window;
    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
    host.appendChild(c);
    return id;
});

// Moves the element into another top-level window's div
EM_JS(void, wxglSetHost, (int id, int windowId), {
    var c = document.getElementById('wxgl-' + id);
    var data = windowMap.get(windowId);
    if (!c || !data) return;
    var host = data.window;
    if (c.parentNode === host) return;
    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
    host.appendChild(c);
});

EM_JS(void, wxglSetRect, (int id, int x, int y, int w, int h, int shown, double scale), {
    var c = document.getElementById('wxgl-' + id);
    if (!c) return;
    c.style.left = x + 'px';
    c.style.top = y + 'px';
    c.style.width = w + 'px';
    c.style.height = h + 'px';
    var pw = Math.max(1, Math.round(w * scale)), ph = Math.max(1, Math.round(h * scale));
    if (c.width !== pw) c.width = pw;
    if (c.height !== ph) c.height = ph;
    c.style.display = (shown && w > 0 && h > 0) ? 'block' : 'none';
});

EM_JS(void, wxglDestroyElement, (int id), {
    var c = document.getElementById('wxgl-' + id);
    if (c && c.parentNode) c.parentNode.removeChild(c);
});

EM_JS(double, wxglScale, (), {
    return window.devicePixelRatio || 1;
});

