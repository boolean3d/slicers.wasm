+}
+
+void kg_Vertex2f( GLfloat x, GLfloat y ) { vertex( x, y, 0 ); }
+void kg_Vertex2d( GLdouble x, GLdouble y ) { vertex( x, y, 0 ); }
+void kg_Vertex3f( GLfloat x, GLfloat y, GLfloat z ) { vertex( x, y, z ); }
+void kg_Vertex3d( GLdouble x, GLdouble y, GLdouble z ) { vertex( x, y, z ); }
