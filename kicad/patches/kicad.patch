+    S().pointSize = size;
+}
+
+void kg_GetFloatv( GLenum p, GLfloat* v )
+{
+    int st = p == KG_MODELVIEW_MATRIX ? 0 : p == KG_PROJECTION_MATRIX ? 1 : p == KG_TEXTURE_MATRIX ? 2 : -1;
+
+    if( st < 0 )
+    {
+        glGetFloatv( p, v );
+        return;
+    }
+
+    for( int i = 0; i < 16; i++ )
+        v[i] = (float) S().stacks[st].back().m[i];
+}
