+void vertex( float x, float y, float z )
+{
+    VTX v = { { x, y, z, 1 }, {}, {}, {} };
+    memcpy( v.col, S().col, sizeof v.col );
+    memcpy( v.tex, S().tex, sizeof v.tex );
