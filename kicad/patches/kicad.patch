+// ── capabilities ──
+bool isEsCap( GLenum c )
+{
+    switch( c )
+    {
+    case GL_BLEND:
+    case GL_CULL_FACE:
+    case GL_DEPTH_TEST:
+    case GL_DITHER:
+    case GL_POLYGON_OFFSET_FILL:
+    case GL_PRIMITIVE_RESTART_FIXED_INDEX:
+    case GL_RASTERIZER_DISCARD:
+    case GL_SAMPLE_ALPHA_TO_COVERAGE:
+    case GL_SAMPLE_COVERAGE:
+    case GL_SCISSOR_TEST:
+    case GL_STENCIL_TEST: return true;
+    default: return false;
+    }
+}
+
+void setCap( GLenum c, bool on )
+{
+    KG_RECORD( setCap( c, on ) );
+    STATE& s = S();
+
+    if( c == GL_TEXTURE_2D )
+        s.texOn[s.activeUnit] = on;
+    else if( c == KG_ALPHA_TEST )
+        s.alphaTest = on;
+    else if( c == KG_LIGHTING )
+        s.lighting = on;
+    else if( c >= KG_LIGHT0 && c < KG_LIGHT0 + N_LIGHTS )
+        s.lights[c - KG_LIGHT0].on = on;
+    else if( c == KG_COLOR_MATERIAL )
+        s.colorMaterial = on;
+    else if( isEsCap( c ) )
+        on ? glEnable( c ) : glDisable( c );
+    // anything else (smoothing, multisample, normalize: normals are always normalized here) has no meaning here
+}
+
+void kg_Enable( GLenum c ) { setCap( c, true ); }
+void kg_Disable( GLenum c ) { setCap( c, false ); }
+
+GLboolean kg_IsEnabled( GLenum c )
+{
+    STATE& s = S();
+
+    if( c == GL_TEXTURE_2D )
+        return s.texOn[s.activeUnit];
+
+    if( c == KG_ALPHA_TEST )
+        return s.alphaTest;
+
+    if( c == KG_LIGHTING )
+        return s.lighting;
+
+    if( c >= KG_LIGHT0 && c < KG_LIGHT0 + N_LIGHTS )
+        return s.lights[c - KG_LIGHT0].on;
+
+    if( c == KG_COLOR_MATERIAL )
+        return s.colorMaterial;
+
+    return isEsCap( c ) ? glIsEnabled( c ) : GL_FALSE;
+}
+
+void kg_ActiveTexture( GLenum t )
+{
+    int u = (int) ( t - GL_TEXTURE0 );
+    S().activeUnit = u >= 0 && u < 32 ? u : 0;
+    glActiveTexture( t );
+}
