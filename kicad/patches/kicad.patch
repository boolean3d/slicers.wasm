+void kg_DeleteShader( GLuint sh )
+{
+    S().shaderTypes.erase( sh );
+    glDeleteShader( sh );
+}
+
+// ── framebuffers: one colour attachment at a time ──
+GLuint& boundFbo( GLenum target )
+{
+    return target == GL_READ_FRAMEBUFFER ? S().readFbo : S().drawFbo;
+}
+
+void kg_BindFramebuffer( GLenum target, GLuint f )
+{
+    if( target == GL_FRAMEBUFFER )
+        S().drawFbo = S().readFbo = f;
+    else
+        boundFbo( target ) = f;
+
+    glBindFramebuffer( target, f );
+}
+
+void attachAt0( GLenum target, GLuint fbo, int n )
+{
+    auto& m = S().attach[fbo];
+    auto  it = m.find( n );
+
+    if( it == m.end() || S().current[fbo] == n )
+        return;
+
+    glFramebufferTexture2D( target, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, it->second, 0 );
+    S().current[fbo] = n;
+}
+
+void kg_FramebufferTexture2D( GLenum target, GLenum att, GLenum textarget, GLuint tex, GLint level )
+{
+    int n = (int) att - (int) GL_COLOR_ATTACHMENT0;
+
+    if( n >= 0 && n < 32 )
+    {
+        GLuint fbo = boundFbo( target == GL_FRAMEBUFFER ? GL_DRAW_FRAMEBUFFER : target );
+        S().attach[fbo][n] = tex;
+        S().current[fbo] = n;
+        glFramebufferTexture2D( target, GL_COLOR_ATTACHMENT0, textarget, tex, level );
+        return;
+    }
+
+    glFramebufferTexture2D( target, att, textarget, tex, level );
+}
+
+void kg_DrawBuffer( GLenum buf )
+{
+    GLuint fbo = S().drawFbo;
+
+    if( fbo == 0 )
+    {
+        GLenum b = buf == GL_NONE ? GL_NONE : GL_BACK;
+        glDrawBuffers( 1, &b );
+        return;
+    }
+
+    int n = (int) buf - (int) GL_COLOR_ATTACHMENT0;
+
+    if( n < 0 || n >= 32 )
+    {
+        GLenum b = GL_NONE;
+        glDrawBuffers( 1, &b );
+        return;
+    }
+
+    attachAt0( GL_DRAW_FRAMEBUFFER, fbo, n );
+    GLenum b = GL_COLOR_ATTACHMENT0;
+    glDrawBuffers( 1, &b );
+}
+
+void kg_ReadBuffer( GLenum buf )
+{
+    GLuint fbo = S().readFbo;
+
+    if( fbo == 0 )
+    {
+        glReadBuffer( buf == GL_NONE ? GL_NONE : GL_BACK );
+        return;
+    }
+
+    int n = (int) buf - (int) GL_COLOR_ATTACHMENT0;
+
+    if( n >= 0 && n < 32 )
+    {
+        attachAt0( GL_READ_FRAMEBUFFER, fbo, n );
+        glReadBuffer( GL_COLOR_ATTACHMENT0 );
+    }
+    else
+    {
+        glReadBuffer( buf );
+    }
+}
+
+void kg_DeleteFramebuffers( GLsizei n, const GLuint* f )
+{
+    for( GLsizei i = 0; i < n; i++ )
+    {
+        S().attach.erase( f[i] );
+        S().current.erase( f[i] );
+    }
+
+    glDeleteFramebuffers( n, f );
+}
+
+void kg_DeleteTextures( GLsizei n, const GLuint* t )
+{
+    for( auto& fb : S().attach )
+        for( auto it = fb.second.begin(); it != fb.second.end(); )
+        {
+            bool gone = false;
+
+            for( GLsizei i = 0; i < n; i++ )
+                gone |= it->second == t[i];
+
+            it = gone ? fb.second.erase( it ) : std::next( it );
+        }
+
+    glDeleteTextures( n, t );
+}
+
+// ── queries ──
+void kg_GetIntegerv( GLenum p, GLint* v )
+{
+    STATE& s = S();
+
+    if( p == KG_DRAW_BUFFER || p == GL_DRAW_BUFFER0 )
+    {
+        *v = s.drawFbo == 0 ? GL_BACK : GL_COLOR_ATTACHMENT0 + s.current[s.drawFbo];
+        return;
+    }
+
+    if( p == GL_READ_BUFFER )
+    {
+        *v = s.readFbo == 0 ? GL_BACK : GL_COLOR_ATTACHMENT0 + s.current[s.readFbo];
+        return;
+    }
+
+    if( p == KG_MATRIX_MODE )
+    {
+        *v = s.mode == 1 ? KG_PROJECTION : s.mode == 2 ? KG_TEXTURE : KG_MODELVIEW;
+        return;
+    }
+
+    glGetIntegerv( p, v );
+
+    if( p == GL_NUM_EXTENSIONS )
+        *v += N_EXTRA_EXTS;
+    else if( p == GL_MAX_COLOR_ATTACHMENTS || p == GL_MAX_DRAW_BUFFERS )
+        *v = 16; // attachments are swapped in at 0, so any number fits
+}
+
+const GLubyte* kg_GetStringi( GLenum name, GLuint i )
+{
+    if( name == GL_EXTENSIONS )
+    {
+        GLint real = 0;
+        glGetIntegerv( GL_NUM_EXTENSIONS, &real );
+
+        if( i >= (GLuint) real && i < (GLuint) ( real + N_EXTRA_EXTS ) )
+            return (const GLubyte*) EXTRA_EXTS[i - real];
+    }
+
+    return glGetStringi( name, i );
+}
