+
+static const KIPLUGIN_BUILTIN_FN s_vrmlPlugin[] = KIPLUGIN_TABLE( vrml_ );
+static const KIPLUGIN_BUILTIN_FN s_ocePlugin[] = KIPLUGIN_TABLE( oce_ );
+
+bool KIPLUGIN_BUILTIN_LIB::Load( const wxString& aName, int )
+{
+    const KIPLUGIN_BUILTIN_FN* t = aName == wxT( "builtin:vrml" ) ? s_vrmlPlugin
+                                 : aName == wxT( "builtin:oce" )  ? s_ocePlugin
+                                                                    : nullptr;
+    m_table = ( t && t[0].fn ) ? t : nullptr;
+    return IsLoaded();
+}
+
+void* KIPLUGIN_BUILTIN_LIB::GetSymbol( const wxString& aName ) const
+{
+    for( const KIPLUGIN_BUILTIN_FN* r = m_table; r && r->name; r++ )
+    {
+        if( aName == r->name )
+            return r->fn;
+    }
+
+    return nullptr;
+}
+#endif
