+// GLU's GL calls (its quadrics and projection: the 3D view's arrows and pivot, the footprint preview), renamed
+// kigl_glu_* when GLU is built (spike/gui/build-glu.sh).
+extern "C"
+{
+void kigl_glu_Begin( GLenum m ) { kg_Begin( m ); }
+void kigl_glu_End( void ) { kg_End(); }
+void kigl_glu_MultMatrixd( const GLdouble* m ) { kg_MultMatrixd( m ); }
+void kigl_glu_MultMatrixf( const GLfloat* m ) { kg_MultMatrixf( m ); }
+void kigl_glu_Normal3f( GLfloat x, GLfloat y, GLfloat z ) { kg_Normal3f( x, y, z ); }
+void kigl_glu_Ortho( GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f ) { kg_Ortho( l, r, b, t, n, f ); }
+void kigl_glu_Scalef( GLfloat x, GLfloat y, GLfloat z ) { kg_Scalef( x, y, z ); }
+void kigl_glu_TexCoord2f( GLfloat s, GLfloat t ) { kg_TexCoord2f( s, t ); }
+void kigl_glu_Translated( GLdouble x, GLdouble y, GLdouble z ) { kg_Translated( x, y, z ); }
+void kigl_glu_Translatef( GLfloat x, GLfloat y, GLfloat z ) { kg_Translatef( x, y, z ); }
+void kigl_glu_Vertex3f( GLfloat x, GLfloat y, GLfloat z ) { kg_Vertex3f( x, y, z ); }
+}
+
+
+extern "C" void* kigl_es_proc( const char* name )
+{
+    for( const ENTRY& e : ENTRIES )
+    {
+        if( strcmp( e.name, name ) == 0 )
+            return e.fn;
+    }
+
+    return emscripten_webgl_get_proc_address( name );
+}
