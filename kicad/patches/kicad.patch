+// ── lighting ──
+VEC4 vec4( const GLfloat* v, int n )
+{
+    VEC4 r = { 0, 0, 0, 1 };
+
+    for( int i = 0; i < n; i++ )
+        r[i] = v[i];
+
+    return r;
+}
+
+void lightv( GLenum light, GLenum pname, VEC4 v )
+{
+    KG_RECORD( lightv( light, pname, v ) );
+    int i = (int) light - (int) KG_LIGHT0;
+
+    if( i < 0 || i >= N_LIGHTS )
+        return;
+
+    LIGHT& l = S().lights[i];
+
+    switch( pname )
+    {
+    case KG_AMBIENT:  l.amb = v; break;
+    case KG_DIFFUSE:  l.dif = v; break;
+    case KG_SPECULAR: l.spec = v; break;
+    case KG_POSITION:
+    {
+        const double* m = S().stacks[0].back().m;   // into eye space by the modelview of now
+
+        for( int r = 0; r < 4; r++ )
+            l.pos[r] = (float) ( m[r] * v[0] + m[4 + r] * v[1] + m[8 + r] * v[2] + m[12 + r] * v[3] );
+
+        break;
+    }
+    default: break;                                 // spot and attenuation: KiCad leaves them at their defaults
+    }
+}
+
+void kg_Lightfv( GLenum light, GLenum pname, const GLfloat* v )
+{
+    lightv( light, pname, vec4( v, pname == KG_POSITION || pname == KG_AMBIENT || pname == KG_DIFFUSE
+                                       || pname == KG_SPECULAR ? 4 : 1 ) );
+}
+
+void kg_Lightf( GLenum light, GLenum pname, GLfloat v ) { lightv( light, pname, vec4( &v, 1 ) ); }
+
+void lightModel( GLenum pname, VEC4 v )
+{
+    KG_RECORD( lightModel( pname, v ) );
+
+    if( pname == KG_LIGHT_MODEL_AMBIENT )
+        S().modelAmb = v;
+    else if( pname == KG_LIGHT_MODEL_TWO_SIDE )
+        S().twoSide = v[0] != 0;
+}
+
+void kg_LightModelfv( GLenum pname, const GLfloat* v )
+{
+    lightModel( pname, vec4( v, pname == KG_LIGHT_MODEL_AMBIENT ? 4 : 1 ) );
+}
+
+void kg_LightModelf( GLenum pname, GLfloat v ) { lightModel( pname, vec4( &v, 1 ) ); }
+void kg_LightModeli( GLenum pname, GLint v ) { float f = (float) v; lightModel( pname, vec4( &f, 1 ) ); }
+
+void materialv( GLenum face, GLenum pname, VEC4 v )
+{
+    KG_RECORD( materialv( face, pname, v ) );
+
+    for( int f = 0; f < 2; f++ )
+    {
+        if( ( f == 0 && face == KG_BACK ) || ( f == 1 && face == KG_FRONT ) )
+            continue;
+
+        MATERIAL& m = S().mat[f];
+
+        switch( pname )
+        {
+        case KG_AMBIENT:             m.amb = v; break;
+        case KG_DIFFUSE:             m.dif = v; break;
+        case KG_AMBIENT_AND_DIFFUSE: m.amb = v; m.dif = v; break;
+        case KG_SPECULAR:            m.spec = v; break;
+        case KG_EMISSION:            m.emi = v; break;
+        case KG_SHININESS:           m.shin = v[0]; break;
+        default: break;
+        }
+    }
+}
+
+void kg_Materialfv( GLenum face, GLenum pname, const GLfloat* v )
+{
+    materialv( face, pname, vec4( v, pname == KG_SHININESS ? 1 : 4 ) );
+}
+
+void kg_Materialf( GLenum face, GLenum pname, GLfloat v ) { materialv( face, pname, vec4( &v, 1 ) ); }
+
+void kg_ColorMaterial( GLenum face, GLenum mode )
+{
+    KG_RECORD( kg_ColorMaterial( face, mode ) );
+    S().colorMaterialMode = mode;
+}
