+void kg_UseProgram( GLuint p )
+{
+    S().program = p;
+    useProgramGL( p );
+}
+
+GLuint kg_CreateShader( GLenum type )
+{
+    GLuint sh = glCreateShader( type );
+    S().shaderTypes[sh] = type;
