+
+// ── the built-in program (drawing with no program bound) ──
+// Lighting is the desktop's fixed-function formula, per vertex: emission + ambient x model ambient + for each light
+// ambient + diffuse x max(N.L, 0) + specular x max(N.H, 0)^shininess (H with the viewer at infinity), clamped; the
+// alpha is the diffuse one. Two-sided lighting gives back faces their own colour (the back material, the normal
+// turned round).
+const char* FIXED_VS = "#version 300 es\n"
+                       "precision highp float;\n"
+                       "in vec4 kg_Vertex; in vec4 kg_Color; in vec4 kg_MultiTexCoord0; in vec4 kg_Normal;\n"
+                       "uniform mat4 kg_MVP; uniform mat4 kg_TexMatrix; uniform mat4 kg_MV; uniform mat3 kg_NormalMat;\n"
+                       "uniform int kg_Lighting; uniform int kg_TwoSide; uniform int kg_ColorMat; uniform float kg_PointSize;\n"
+                       "uniform int kg_LightOn[8]; uniform vec4 kg_LAmb[8]; uniform vec4 kg_LDif[8]; uniform vec4 kg_LSpec[8];\n"
+                       "uniform vec4 kg_LPos[8]; uniform vec4 kg_ModelAmb;\n"
+                       "uniform vec4 kg_MAmb[2]; uniform vec4 kg_MDif[2]; uniform vec4 kg_MSpec[2]; uniform vec4 kg_MEmi[2];\n"
+                       "uniform float kg_MShin[2];\n"
+                       "out vec4 c; out vec4 cb; out vec2 t;\n"
+                       "vec4 shade( int f, vec3 n, vec3 v ) {\n"
+                       " vec4 amb = ( kg_ColorMat == 1 || kg_ColorMat == 2 ) ? kg_Color : kg_MAmb[f];\n"
+                       " vec4 dif = ( kg_ColorMat == 1 || kg_ColorMat == 3 ) ? kg_Color : kg_MDif[f];\n"
+                       " vec3 r = kg_MEmi[f].rgb + amb.rgb * kg_ModelAmb.rgb;\n"
+                       " for( int i = 0; i < 8; i++ ) {\n"
+                       "  if( kg_LightOn[i] == 0 ) continue;\n"
+                       "  vec3 L = kg_LPos[i].w == 0.0 ? normalize( kg_LPos[i].xyz ) : normalize( kg_LPos[i].xyz / kg_LPos[i].w - v );\n"
+                       "  float d = max( dot( n, L ), 0.0 );\n"
+                       "  r += amb.rgb * kg_LAmb[i].rgb + d * dif.rgb * kg_LDif[i].rgb;\n"
+                       "  if( d > 0.0 ) {\n"
+                       "   float nh = max( dot( n, normalize( L + vec3( 0.0, 0.0, 1.0 ) ) ), 0.0 );\n"
+                       "   r += ( kg_MShin[f] > 0.0 ? pow( nh, kg_MShin[f] ) : 1.0 ) * kg_MSpec[f].rgb * kg_LSpec[i].rgb;\n"
+                       "  }\n"
+                       " }\n"
+                       " return vec4( clamp( r, 0.0, 1.0 ), dif.a );\n"
+                       "}\n"
+                       "void main() { gl_Position = kg_MVP * kg_Vertex; gl_PointSize = kg_PointSize;"
+                       " vec4 q = kg_TexMatrix * kg_MultiTexCoord0; t = q.xy / q.w;\n"
+                       " if( kg_Lighting == 1 ) {\n"
+                       "  vec4 e = kg_MV * kg_Vertex; vec3 v = e.xyz / e.w;\n"
+                       "  vec3 n = kg_NormalMat * kg_Normal.xyz; float l = length( n ); n = l > 0.0 ? n / l : vec3( 0.0, 0.0, 1.0 );\n"
+                       "  c = shade( 0, n, v ); cb = kg_TwoSide == 1 ? shade( 1, -n, v ) : c;\n"
+                       " } else { c = kg_Color; cb = kg_Color; }\n"
+                       "}\n";
+
+const char* FIXED_FS = "#version 300 es\n"
+                       "precision highp float;\n"
+                       "in vec4 c; in vec4 cb; in vec2 t; out vec4 o;\n"
+                       "uniform sampler2D kg_Tex; uniform int kg_UseTex; uniform int kg_AlphaFunc; uniform float kg_AlphaRef;\n"
+                       "uniform int kg_EnvMode; uniform vec4 kg_EnvColor;\n"
+                       "void main() { o = gl_FrontFacing ? c : cb;\n"
+                       " if( kg_UseTex == 1 ) {\n"
+                       "  if( kg_EnvMode == 1 ) o.a *= kg_EnvColor.a;\n"      // the models' combine: colour as lit, alpha x env alpha
+                       "  else if( kg_EnvMode == 2 ) o = texture( kg_Tex, t );\n"
+                       "  else o *= texture( kg_Tex, t ); }\n"
+                       " bool pass = kg_AlphaFunc == 0 || ( kg_AlphaFunc == 1 && o.a > kg_AlphaRef )"
+                       " || ( kg_AlphaFunc == 2 && o.a >= kg_AlphaRef ) || ( kg_AlphaFunc == 3 && o.a < kg_AlphaRef )"
+                       " || ( kg_AlphaFunc == 4 && o.a <= kg_AlphaRef ) || ( kg_AlphaFunc == 5 && o.a == kg_AlphaRef )"
+                       " || ( kg_AlphaFunc == 6 && o.a != kg_AlphaRef );\n"
+                       " if( !pass ) discard; }\n";
+
+GLuint compile( GLenum type, const char* src )
+{
+    GLuint sh = glCreateShader( type );
+    glShaderSource( sh, 1, &src, nullptr );
+    glCompileShader( sh );
+
+    GLint ok = 0;
+    glGetShaderiv( sh, GL_COMPILE_STATUS, &ok );
+
+    if( !ok )
+    {
+        char log[1024] = "";
+        glGetShaderInfoLog( sh, sizeof log, nullptr, log );
+        fprintf( stderr, "kicad: the OpenGL stand-in's own shader did not compile: %s\n", log );
+    }
+
+    return sh;
+}
+
+void bindKgAttribs( GLuint prog )
+{
+    glBindAttribLocation( prog, 0, "kg_Vertex" );
+    glBindAttribLocation( prog, 1, "kg_Color" );
+    glBindAttribLocation( prog, 2, "kg_MultiTexCoord0" );
+    glBindAttribLocation( prog, 3, "kg_Normal" );
+}
+
+// Inverse transpose of the modelview's upper 3x3 (normals into eye space).
+void normalMatrix( float out[9] )
+{
+    const double* m = S().stacks[0].back().m;
+    double a = m[0], b = m[4], c = m[8], d = m[1], e = m[5], f = m[9], g = m[2], h = m[6], i = m[10];
+    double A = e * i - f * h, B = -( d * i - f * g ), C = d * h - e * g;
+    double det = a * A + b * B + c * C;
+
+    if( det == 0 )
+        det = 1;
+
+    // cofactor matrix / det = inverse transpose; stored column-major
+    double cof[9] = { A, B, C,
+                      -( b * i - c * h ), a * i - c * g, -( a * h - b * g ),
+                      b * f - c * e, -( a * f - c * d ), a * e - b * d };
+
+    for( int r = 0; r < 3; r++ )      // row r of the cofactor matrix -> column... cof[r*3+k] is row r, column k
+        for( int k = 0; k < 3; k++ )
+            out[k * 3 + r] = (float) ( cof[r * 3 + k] / det );
+}
+
+// Test switch (kicad-play-10): <program>/?glcache=MASK keeps only the given caches (1 program, 2 attribute pointers,
+// 4 attribute enables, 8 array binding, 16 uniforms, 32 attribute constants); without it every cache is on.
+EM_JS( int, kigl_cache_mask_js, (), {
+    try
+    {
+        var m = /[?&]glcache=(\d+)/.exec( self.location.search || '' );
+        if( m ) { console.log( 'kicad: test switch glcache=' + m[1] ); return parseInt( m[1] ); }
+    }
+    catch( e ) {}
+    return 63;
+} );
+
+int cacheMask()
+{
+    static int mask = -1;
+
+    if( mask < 0 )
+    {
+        mask = kigl_cache_mask_js();
+        const char* e = getenv( "KIGL_CACHE" );   // kicad-pre.js: ENV.KIGL_CACHE from the page's ?glcache=
+
+        if( e )
+        {
+            mask = atoi( e );
+            printf( "kicad: test switch glcache=%d (KIGL_CACHE)\n", mask );
+        }
+    }
+
+    return mask;
+}
+
+// GL_ARRAY_BUFFER binding, attribute pointers and enables, program: told to GL only when they change
+void bindArray( GLuint b )
+{
+    STATE& s = S();
+
+    if( s.glArrayBuffer == b && ( cacheMask() & 8 ) )
+        return;
+
+    s.glArrayBuffer = b;
+    glBindBuffer( GL_ARRAY_BUFFER, b );
+}
+
+void attribPointer( GLuint a, GLuint buffer, GLint size, GLenum type, GLboolean norm, GLsizei stride, const void* ptr )
+{
+    STATE::GLATTR& g = S().glAttr[a];
+
+    if( g.valid && g.buffer == buffer && g.size == size && g.type == type && g.norm == norm && g.stride == stride
+        && g.ptr == ptr && ( cacheMask() & 2 ) )
+        return;
+
+    bindArray( buffer );
+    glVertexAttribPointer( a, size, type, norm, stride, ptr );
+    bool on = g.valid ? g.on : false;
+    g = STATE::GLATTR{ true, on, buffer, size, type, norm, stride, ptr };
+}
+
+void attribEnable( GLuint a, bool on )
+{
+    STATE::GLATTR& g = S().glAttr[a];
+
+    if( g.valid && g.on == on && ( cacheMask() & 4 ) )
+        return;
+
+    on ? glEnableVertexAttribArray( a ) : glDisableVertexAttribArray( a );
+    g.valid = true;   // a pointer never set stays "unknown" (size 0 never matches a real one)
+    g.on = on;
+}
+
+void useProgramGL( GLuint p )
+{
+    STATE& s = S();
+
+    if( s.glProg == p && ( cacheMask() & 1 ) )
+        return;
+
+    s.glProg = p;
+    glUseProgram( p );
+}
+
+// Buffers going away: GL unbinds a deleted buffer from GL_ARRAY_BUFFER; the attribute caches referring to it forget it.
+void forgetBuffers( GLsizei n, const GLuint* ids )
+{
+    STATE& s = S();
+
+    for( GLsizei i = 0; i < n; i++ )
+    {
+        if( ids[i] == 0 )
+            continue;
+
+        if( s.glArrayBuffer == ids[i] )
+            s.glArrayBuffer = 0;
+
+        for( STATE::GLATTR& g : s.glAttr )
+        {
+            if( g.buffer == ids[i] )
+                g.valid = false;
+        }
+    }
+}
+
+template <size_t N>
+void sendFv( GLint loc, float ( &sent )[N], const float* cur, bool valid, void ( *fn )( GLint, GLsizei, const GLfloat* ) )
+{
+    if( valid && memcmp( sent, cur, sizeof sent ) == 0 )
+        return;
+
+    memcpy( sent, cur, sizeof sent );
+    fn( loc, (GLsizei) ( N / 4 ), cur );
+}
+
+void send1i( GLint loc, int& sent, int cur, bool valid )
+{
+    if( valid && sent == cur )
+        return;
+
+    sent = cur;
+    glUniform1i( loc, cur );
+}
+
+void send1f( GLint loc, float& sent, float cur, bool valid )
+{
+    if( valid && sent == cur )
+        return;
+
+    sent = cur;
+    glUniform1f( loc, cur );
+}
+
+void useFixed()
+{
+    STATE& s = S();
+
+    if( !s.fixedProg )
+    {
+        s.fixedProg = glCreateProgram();
+        GLuint vs = compile( GL_VERTEX_SHADER, FIXED_VS );
+        GLuint fs = compile( GL_FRAGMENT_SHADER, FIXED_FS );
+        glAttachShader( s.fixedProg, vs );
+        glAttachShader( s.fixedProg, fs );
+        bindKgAttribs( s.fixedProg );
+        glLinkProgram( s.fixedProg );
+        glDeleteShader( vs );
+        glDeleteShader( fs );
+        GLuint p = s.fixedProg;
+        s.fxMvp = glGetUniformLocation( p, "kg_MVP" );
+        s.fxTexMat = glGetUniformLocation( p, "kg_TexMatrix" );
+        s.fxUseTex = glGetUniformLocation( p, "kg_UseTex" );
+        s.fxTex = glGetUniformLocation( p, "kg_Tex" );
+        s.fxAlpha = glGetUniformLocation( p, "kg_AlphaRef" );
+        s.fxAlphaFunc = glGetUniformLocation( p, "kg_AlphaFunc" );
+        s.fxMv = glGetUniformLocation( p, "kg_MV" );
+        s.fxNormalMat = glGetUniformLocation( p, "kg_NormalMat" );
+        s.fxLighting = glGetUniformLocation( p, "kg_Lighting" );
+        s.fxTwoSide = glGetUniformLocation( p, "kg_TwoSide" );
+        s.fxColorMat = glGetUniformLocation( p, "kg_ColorMat" );
+        s.fxPointSize = glGetUniformLocation( p, "kg_PointSize" );
+        s.fxLightOn = glGetUniformLocation( p, "kg_LightOn" );
+        s.fxLAmb = glGetUniformLocation( p, "kg_LAmb" );
+        s.fxLDif = glGetUniformLocation( p, "kg_LDif" );
+        s.fxLSpec = glGetUniformLocation( p, "kg_LSpec" );
+        s.fxLPos = glGetUniformLocation( p, "kg_LPos" );
+        s.fxModelAmb = glGetUniformLocation( p, "kg_ModelAmb" );
+        s.fxMAmb = glGetUniformLocation( p, "kg_MAmb" );
+        s.fxMDif = glGetUniformLocation( p, "kg_MDif" );
+        s.fxMSpec = glGetUniformLocation( p, "kg_MSpec" );
+        s.fxMEmi = glGetUniformLocation( p, "kg_MEmi" );
+        s.fxMShin = glGetUniformLocation( p, "kg_MShin" );
+        s.fxEnvMode = glGetUniformLocation( p, "kg_EnvMode" );
+        s.fxEnvColor = glGetUniformLocation( p, "kg_EnvColor" );
+    }
+
+    useProgramGL( s.fixedProg );
+    STATE::FXSENT& f = s.fx;
+    const bool     v = f.valid && ( cacheMask() & 16 );
+    float          m[16];
+    mvp( m );
+
+    if( !v || memcmp( f.mvp, m, sizeof m ) != 0 )
+    {
+        memcpy( f.mvp, m, sizeof m );
+        glUniformMatrix4fv( s.fxMvp, 1, GL_FALSE, m );
+    }
+
+    for( int i = 0; i < 16; i++ )
+        m[i] = (float) s.stacks[2].back().m[i];
+
+    if( !v || memcmp( f.texMat, m, sizeof m ) != 0 )
+    {
+        memcpy( f.texMat, m, sizeof m );
+        glUniformMatrix4fv( s.fxTexMat, 1, GL_FALSE, m );
+    }
+
+    send1i( s.fxUseTex, f.useTex, s.texOn[0] ? 1 : 0, v );
+
+    if( !v )
+        glUniform1i( s.fxTex, 0 );
+
+    send1i( s.fxEnvMode, f.envMode, s.envMode == KG_COMBINE ? 1 : s.envMode == KG_REPLACE ? 2 : 0, v );
+    sendFv( s.fxEnvColor, f.envColor, s.envColor.data(), v, glUniform4fv );
+    send1f( s.fxPointSize, f.pointSize, s.pointSize, v );
+
+    int fn = 0;
+
+    if( s.alphaTest )
+    {
+        switch( s.alphaFunc )
+        {
+        case GL_GREATER:  fn = 1; break;
+        case GL_GEQUAL:   fn = 2; break;
+        case GL_LESS:     fn = 3; break;
+        case GL_LEQUAL:   fn = 4; break;
+        case GL_EQUAL:    fn = 5; break;
+        case GL_NOTEQUAL: fn = 6; break;
+        case GL_NEVER:    fn = 7; break;   // no branch passes: everything is discarded
+        default:          fn = 0;
+        }
+    }
+
+    send1i( s.fxAlphaFunc, f.alphaFunc, fn, v );
+    send1f( s.fxAlpha, f.alphaRef, s.alphaRef, v );
+    send1i( s.fxLighting, f.lighting, s.lighting ? 1 : 0, v );
+
+    f.valid = true;
+
+    if( !s.lighting )
+        return;
+
+    const bool lv = f.litValid && ( cacheMask() & 16 );
+
+    for( int i = 0; i < 16; i++ )
+        m[i] = (float) s.stacks[0].back().m[i];
+
+    if( !lv || memcmp( f.mv, m, sizeof m ) != 0 )
+    {
+        memcpy( f.mv, m, sizeof m );
+        glUniformMatrix4fv( s.fxMv, 1, GL_FALSE, m );
+    }
+
+    float nm[9];
+    normalMatrix( nm );
+
+    if( !lv || memcmp( f.nm, nm, sizeof nm ) != 0 )
+    {
+        memcpy( f.nm, nm, sizeof nm );
+        glUniformMatrix3fv( s.fxNormalMat, 1, GL_FALSE, nm );
+    }
+
+    send1i( s.fxTwoSide, f.twoSide, s.twoSide ? 1 : 0, lv );
+
+    int cm = 0;
+
+    if( s.colorMaterial )
+        cm = s.colorMaterialMode == KG_AMBIENT_AND_DIFFUSE ? 1 : s.colorMaterialMode == KG_AMBIENT ? 2
+           : s.colorMaterialMode == KG_DIFFUSE ? 3 : 0;
+
+    send1i( s.fxColorMat, f.colorMat, cm, lv );
+
+    GLint on[N_LIGHTS];
+    float amb[N_LIGHTS * 4], dif[N_LIGHTS * 4], spec[N_LIGHTS * 4], pos[N_LIGHTS * 4];
+
+    for( int i = 0; i < N_LIGHTS; i++ )
+    {
+        const LIGHT& l = s.lights[i];
+        on[i] = l.on ? 1 : 0;
+        memcpy( amb + i * 4, l.amb.data(), 16 );
+        memcpy( dif + i * 4, l.dif.data(), 16 );
+        memcpy( spec + i * 4, l.spec.data(), 16 );
+        memcpy( pos + i * 4, l.pos.data(), 16 );
+    }
+
+    if( !lv || memcmp( f.on, on, sizeof on ) != 0 )
+    {
+        memcpy( f.on, on, sizeof on );
+        glUniform1iv( s.fxLightOn, N_LIGHTS, on );
+    }
+
+    sendFv( s.fxLAmb, f.amb, amb, lv, glUniform4fv );
+    sendFv( s.fxLDif, f.dif, dif, lv, glUniform4fv );
+    sendFv( s.fxLSpec, f.spec, spec, lv, glUniform4fv );
+    sendFv( s.fxLPos, f.pos, pos, lv, glUniform4fv );
+    sendFv( s.fxModelAmb, f.modelAmb, s.modelAmb.data(), lv, glUniform4fv );
+
+    float mamb[8], mdif[8], mspec[8], memi[8], mshin[2];
+
+    for( int i = 0; i < 2; i++ )
+    {
+        memcpy( mamb + i * 4, s.mat[i].amb.data(), 16 );
+        memcpy( mdif + i * 4, s.mat[i].dif.data(), 16 );
+        memcpy( mspec + i * 4, s.mat[i].spec.data(), 16 );
+        memcpy( memi + i * 4, s.mat[i].emi.data(), 16 );
+        mshin[i] = s.mat[i].shin;
+    }
+
+    sendFv( s.fxMAmb, f.mamb, mamb, lv, glUniform4fv );
+    sendFv( s.fxMDif, f.mdif, mdif, lv, glUniform4fv );
+    sendFv( s.fxMSpec, f.mspec, mspec, lv, glUniform4fv );
+    sendFv( s.fxMEmi, f.memi, memi, lv, glUniform4fv );
+
+    if( !lv || memcmp( f.mshin, mshin, sizeof mshin ) != 0 )
+    {
+        memcpy( f.mshin, mshin, sizeof mshin );
+        glUniform1fv( s.fxMShin, 2, mshin );
+    }
+
+    f.litValid = true;
+}
+
+// Before a draw: the bound program gets the current matrices; with none bound the built-in one draws.
+// Returns true when the built-in program was bound (unbind it after the draw).
+bool beforeDraw()
+{
+    STATE& s = S();
+
+    const float* cst[N_ARRAYS] = { nullptr, s.col, s.tex, s.nrm };
+
+    for( GLuint a = 1; a < N_ARRAYS; a++ )
+    {
+        if( s.arrayOn[a] )
+            continue;
+
+        if( s.sentAttrValid[a] && memcmp( s.sentAttr[a], cst[a], 16 ) == 0 && ( cacheMask() & 32 ) )
+            continue;
+
+        memcpy( s.sentAttr[a], cst[a], 16 );
+        s.sentAttrValid[a] = true;
+        glVertexAttrib4fv( a, cst[a] );
+    }
+
+    if( s.program == 0 )
+    {
+        useFixed();
+        return true;
+    }
+
+    useProgramGL( s.program );
+    STATE::PROG& p = s.progs[s.program];
+
+    if( p.ver == 0 )
+    {
+        p.mvp = glGetUniformLocation( s.program, "kg_MVP" );
+        p.ver = 0xffffffff; // looked up; set below
+    }
+
+    if( p.mvp >= 0 && p.ver != s.matVersion )
+    {
+        float m[16];
+        mvp( m );
+        glUniformMatrix4fv( p.mvp, 1, GL_FALSE, m );
+        p.ver = s.matVersion;
+    }
+
+    return false;
+}
+
+void afterDraw( bool fixed )
+{
+    // the desktop has no program bound after a fixed-function draw; KiCad's 2D drawing (GAL) stopped with
+    // "switching framebuffer: invalid operation" when the built-in program stayed bound (k16, kicad-play-10)
+    if( fixed )
+        useProgramGL( 0 );
+}
+
+// After a draw from one of our own buffers (a display list, glBegin/glEnd) the attributes point at that buffer.
+// KiCad's arrays go back just before KiCad's next draw, not after every list: a frame of the 3D view calls hundreds
+// of lists between two draws of its own, and the old restore after each one asked glIsBuffer four times (a
+// synchronous round trip to Chrome's GPU process, 64 us each: 81% of a frame, kicad-play-10). A buffer deleted
+// meanwhile is known from kg_DeleteBuffers, so nothing is asked of the GPU.
+void arraysStale()
+{
+    STATE& s = S();
+    s.arraysStale = true;
+    bindArray( s.arrayBuffer );   // a gl*Pointer call from KiCad lands on its own binding
+}
+
+void applyArrays()
+{
+    STATE& s = S();
+
+    if( !s.arraysStale )
+        return;
+
+    s.arraysStale = false;
+
+    for( GLuint a = 0; a < N_ARRAYS; a++ )
+    {
+        const ARRAY& r = s.arrays[a];
+
+        if( r.size > 0 )
+            attribPointer( a, r.buffer, r.size, r.type, r.norm, r.stride, r.ptr );
+
+        attribEnable( a, s.arrayOn[a] );
+    }
+
+    bindArray( s.arrayBuffer );
+}
+
+void drawImmediate( GLenum prim, const std::vector<VTX>& v )
+{
+    STATE&           s = S();
+    std::vector<VTX> quads;
+    const std::vector<VTX>* tri = &v;
+    GLenum           mode = prim;
+
+    if( mode == KG_QUADS )
+    {
+        for( size_t i = 0; i + 3 < v.size(); i += 4 )
+        {
+            const VTX q[6] = { v[i], v[i + 1], v[i + 2], v[i], v[i + 2], v[i + 3] };
+            quads.insert( quads.end(), q, q + 6 );
+        }
+
+        tri = &quads;
+        mode = GL_TRIANGLES;
+    }
+    else if( mode == KG_QUAD_STRIP )
+    {
+        mode = GL_TRIANGLE_STRIP;
+    }
+    else if( mode == KG_POLYGON )
+    {
+        mode = GL_TRIANGLE_FAN;
+    }
+
+    if( tri->empty() )
+        return;
+
+    if( !s.immBuf )
+        glGenBuffers( 1, &s.immBuf );
+
+    bindArray( s.immBuf );
+    glBufferData( GL_ARRAY_BUFFER, tri->size() * sizeof( VTX ), tri->data(), GL_STREAM_DRAW );
+
+    for( GLuint a = 0; a < N_ARRAYS; a++ )
+    {
+        attribEnable( a, true );
+        attribPointer( a, s.immBuf, 4, GL_FLOAT, GL_FALSE, sizeof( VTX ), (const void*) ( a * 4 * sizeof( float ) ) );
+    }
+
+    bool savedOn[N_ARRAYS];
+    memcpy( savedOn, s.arrayOn, sizeof savedOn );
+
+    for( bool& on : s.arrayOn )
+        on = true;                      // every vertex brings its colour, texture coordinate and normal
+
+    bool fixed = beforeDraw();
+    glDrawArrays( mode, 0, (GLsizei) tri->size() );
+    afterDraw( fixed );
+    memcpy( s.arrayOn, savedOn, sizeof savedOn );
+    arraysStale();
+}
+
+void kg_End()
+{
+    STATE& s = S();
+    s.inBegin = false;
+
+    if( recording() )
+    {
+        std::vector<VTX> v = s.verts;
+        GLenum           prim = s.prim;
+        record( [v, prim]() { drawImmediate( prim, v ); } );
+        return;
+    }
+
+    drawImmediate( s.prim, s.verts );
+}
+
+// ── client arrays ──
+int arrayIndex( GLenum a )
+{
+    return a == KG_VERTEX_ARRAY ? 0 : a == KG_COLOR_ARRAY ? 1 : a == KG_TEXTURE_COORD_ARRAY ? 2
+         : a == KG_NORMAL_ARRAY ? 3 : -1;
+}
+
+void kg_EnableClientState( GLenum a )
+{
+    int i = arrayIndex( a );
+
+    if( i >= 0 )
+    {
+        S().arrayOn[i] = true;
+        attribEnable( i, true );
+    }
+}
+
+void kg_DisableClientState( GLenum a )
+{
+    int i = arrayIndex( a );
+
+    if( i >= 0 )
+    {
+        S().arrayOn[i] = false;
+        attribEnable( i, false );
+    }
+}
+
+void setArray( GLuint a, GLint size, GLenum type, GLboolean norm, GLsizei stride, const void* p )
+{
+    ARRAY& r = S().arrays[a];
+    r.size = size;
+    r.type = type;
+    r.norm = norm;
+    r.stride = stride;
+    r.ptr = p;
+    r.buffer = S().arrayBuffer;
+    attribPointer( a, r.buffer, size, type, norm, stride, p );
+}
+
+void kg_VertexPointer( GLint size, GLenum type, GLsizei stride, const void* p )
+{
+    setArray( 0, size, type, GL_FALSE, stride, p );
+}
+
+void kg_ColorPointer( GLint size, GLenum type, GLsizei stride, const void* p )
+{
+    setArray( 1, size, type, type == GL_FLOAT ? GL_FALSE : GL_TRUE, stride, p );
+}
+
+void kg_TexCoordPointer( GLint size, GLenum type, GLsizei stride, const void* p )
+{
+    setArray( 2, size, type, GL_FALSE, stride, p );
+}
+
+void kg_NormalPointer( GLenum type, GLsizei stride, const void* p )
+{
+    setArray( 3, 3, type, type == GL_FLOAT ? GL_FALSE : GL_TRUE, stride, p );   // GL_BYTE normals are -1..1
+}
+
+void kg_ClientActiveTexture( GLenum ) {}   // one texture coordinate array (unit 0)
+
+// KiCad's own attribute calls (kicad-play-11 attrib-calls): on attributes 0-3 the same GL state as the client arrays, recorded
+// with them so they go back after our own draws and the cache knows them; the others pass straight through.
+void kg_VertexAttribPointer( GLuint a, GLint size, GLenum type, GLboolean norm, GLsizei stride, const void* p )
+{
+    if( a < N_ARRAYS )
+        setArray( a, size, type, norm, stride, p );
+    else
+    {
+        if( a < (GLuint) STATE::N_EXTRA )
+            S().extra[a] = ARRAY{ size, type, norm, stride, p, S().arrayBuffer };
+
+        glVertexAttribPointer( a, size, type, norm, stride, p );
+    }
+}
+
+void kg_EnableVertexAttribArray( GLuint a )
+{
+    if( a < N_ARRAYS )
+    {
+        S().arrayOn[a] = true;
+        attribEnable( a, true );
+    }
+    else
+    {
+        if( a < (GLuint) STATE::N_EXTRA )
+            S().extraOn[a] = true;
+
+        glEnableVertexAttribArray( a );
+    }
+}
+
+void kg_DisableVertexAttribArray( GLuint a )
+{
+    if( a < N_ARRAYS )
+    {
+        S().arrayOn[a] = false;
+        attribEnable( a, false );
+    }
+    else
+    {
+        if( a < (GLuint) STATE::N_EXTRA )
+            S().extraOn[a] = false;
+
+        glDisableVertexAttribArray( a );
+    }
+}
+
+void kg_BindBuffer( GLenum target, GLuint b )
+{
+    if( target == GL_ARRAY_BUFFER )
+    {
+        S().arrayBuffer = b;
+        bindArray( b );
+        return;
+    }
+
+    glBindBuffer( target, b );
+}
+
+int typeSize( GLenum t )
+{
+    switch( t )
+    {
+    case GL_BYTE:
+    case GL_UNSIGNED_BYTE: return 1;
+    case GL_SHORT:
+    case GL_UNSIGNED_SHORT:
+    case GL_HALF_FLOAT: return 2;
+    default: return 4;
+    }
+}
+
+// glDrawArrays inside a display list: the client arrays are read now (KiCad frees them after glEndList) into a
+// buffer of the list's own; calling the list draws from it.
+void recordDrawArrays( GLenum mode, GLint first, GLsizei count )
+{
+    STATE& s = S();
+
+    struct SNAP
+    {
+        bool      on[N_ARRAYS] = {};
+        GLint     size[N_ARRAYS] = {};
+        GLenum    type[N_ARRAYS] = {};
+        GLboolean norm[N_ARRAYS] = {};
+        GLintptr  off[N_ARRAYS] = {};
+    } snap;
+
+    std::vector<unsigned char> data;
+
+    for( int a = 0; a < N_ARRAYS; a++ )
+    {
+        const ARRAY& r = s.arrays[a];
+
+        if( !s.arrayOn[a] || r.size <= 0 )
+            continue;
+
+        if( r.buffer != 0 )
+        {
+            fprintf( stderr, "kicad: a display list draws from a buffer object (not kept; drawn without it)\n" );
+            continue;
+        }
+
+        size_t elem = (size_t) r.size * typeSize( r.type );
+        size_t stride = r.stride ? (size_t) r.stride : elem;
+        snap.on[a] = true;
+        snap.size[a] = r.size;
+        snap.type[a] = r.type;
+        snap.norm[a] = r.norm;
+        snap.off[a] = (GLintptr) data.size();
+        data.resize( data.size() + elem * count + ( 4 - elem * count % 4 ) % 4 );
+
+        for( GLsizei i = 0; i < count; i++ )
+            memcpy( &data[snap.off[a] + i * elem], (const unsigned char*) r.ptr + ( first + i ) * stride, elem );
+    }
+
+    GLuint vbo = 0;
+    glGenBuffers( 1, &vbo );
+    bindArray( vbo );
+    glBufferData( GL_ARRAY_BUFFER, data.size(), data.data(), GL_STATIC_DRAW );
+    bindArray( s.arrayBuffer );
+    s.rec->buffers.push_back( vbo );
+
+    record( [snap, vbo, mode, count]()
+            {
+                STATE& st = S();
+                bool savedOn[N_ARRAYS];
+                memcpy( savedOn, st.arrayOn, sizeof savedOn );
+
+                for( GLuint a = 0; a < N_ARRAYS; a++ )
+                {
+                    st.arrayOn[a] = snap.on[a];
+                    attribEnable( a, snap.on[a] );
+
+                    if( snap.on[a] )
+                        attribPointer( a, vbo, snap.size[a], snap.type[a], snap.norm[a], 0, (const void*) snap.off[a] );
+                }
+
+                bool fixed = beforeDraw();
+                glDrawArrays( mode, 0, count );
+                afterDraw( fixed );
+                memcpy( st.arrayOn, savedOn, sizeof savedOn );
+                arraysStale();
+            } );
+}
+
+// glDrawArrays from client arrays (memory, no buffer object: the board editor's non-cached drawing, gpu_manager.cpp):
+// the arrays' vertices first..first+count-1 are copied into a buffer of ours and drawn from it. Emscripten's own
+// emulation copies them into a ring of temporary buffers that ends at 2 MB (GL_MAX_TEMP_BUFFER_SIZE) and fails past it
+// ("Cannot read properties of undefined" in getTempVertexBuffer): Ctrl+A on a board draws a selection larger than that
+// (kicad-crash-2, 10-26). Interleaved arrays (one stride, KiCad's VERTEX) go as one span with their layout kept.
+// Returns false when no enabled array is a client array (the draw is KiCad's buffers only).
+bool drawClientArrays( GLenum mode, GLint first, GLsizei count )
+{
+    STATE& s = S();
+
+    struct CLIENT
+    {
+        GLuint       a;
+        const ARRAY* r;
+        size_t       elem, stride;
+        GLintptr     off;
+    };
+
+    CLIENT  list[STATE::N_EXTRA];
+    int     n = 0;
+    bool    oneStride = true;
+    const unsigned char* lo = nullptr;
+    const unsigned char* hi = nullptr;
+
+    for( GLuint a = 0; a < (GLuint) STATE::N_EXTRA; a++ )
+    {
+        const ARRAY& r = a < N_ARRAYS ? s.arrays[a] : s.extra[a];
+        bool         on = a < N_ARRAYS ? s.arrayOn[a] : s.extraOn[a];
+
+        if( !on || r.size <= 0 || r.buffer != 0 || !r.ptr )
+            continue;
+
+        size_t elem = (size_t) r.size * typeSize( r.type );
+        size_t stride = r.stride ? (size_t) r.stride : elem;
+        const unsigned char* b = (const unsigned char*) r.ptr + (size_t) first * stride;
+        const unsigned char* e = b + ( count > 0 ? ( count - 1 ) * stride + elem : 0 );
+
+        if( n && stride != list[0].stride )
+            oneStride = false;
+
+        lo = n && lo < b ? lo : b;
+        hi = n && hi > e ? hi : e;
+        list[n++] = CLIENT{ a, &r, elem, stride, 0 };
+    }
+
+    if( !n )
+        return false;
+
+    static std::vector<unsigned char> packed;
+    const void* src = lo;
+    size_t      bytes = hi - lo;
+
+    if( oneStride )
+    {
+        for( int k = 0; k < n; k++ )
+            list[k].off = (const unsigned char*) list[k].r->ptr + (size_t) first * list[k].stride - lo;
+    }
+    else
+    {
+        packed.clear();
+
+        for( int k = 0; k < n; k++ )
+        {
+            CLIENT& c = list[k];
+            c.off = (GLintptr) packed.size();
+            packed.resize( packed.size() + c.elem * count + ( 4 - c.elem * count % 4 ) % 4 );
+
+            for( GLsizei i = 0; i < count; i++ )
+                memcpy( &packed[c.off + i * c.elem], (const unsigned char*) c.r->ptr + ( first + i ) * c.stride, c.elem );
+
+            c.stride = c.elem;
+        }
+
+        src = packed.data();
+        bytes = packed.size();
+    }
+
+    if( !s.clientBuf )
+        glGenBuffers( 1, &s.clientBuf );
+
+    bindArray( s.clientBuf );
+    glBufferData( GL_ARRAY_BUFFER, bytes, src, GL_STREAM_DRAW );
+
+    for( int k = 0; k < n; k++ )
+    {
+        const CLIENT& c = list[k];
+
+        if( c.a < N_ARRAYS )
+            attribPointer( c.a, s.clientBuf, c.r->size, c.r->type, c.r->norm, (GLsizei) c.stride, (const void*) c.off );
+        else
+            glVertexAttribPointer( c.a, c.r->size, c.r->type, c.r->norm, (GLsizei) c.stride, (const void*) c.off );
+    }
+
+    bool fixed = beforeDraw();
+    glDrawArrays( mode, 0, count );
+    afterDraw( fixed );
+
+    // KiCad's own pointers back: the four arrays before its next draw, the others now (KiCad may draw again without
+    // setting them)
+    bindArray( 0 );
+
+    for( int k = 0; k < n; k++ )
+    {
+        const CLIENT& c = list[k];
+
+        if( c.a >= N_ARRAYS )
+            glVertexAttribPointer( c.a, c.r->size, c.r->type, c.r->norm, c.r->stride, c.r->ptr );
+    }
+
+    arraysStale();
+    return true;
+}
+
+void kg_DrawArrays( GLenum mode, GLint first, GLsizei count )
+{
+    if( recording() )
+    {
+        recordDrawArrays( mode, first, count );
+        return;
+    }
+
+    applyArrays();
+
+    if( drawClientArrays( mode, first, count ) )
+        return;
+
+    bool fixed = beforeDraw();
+    glDrawArrays( mode, first, count );
+    afterDraw( fixed );
+}
+
+void kg_DrawElements( GLenum mode, GLsizei count, GLenum type, const void* idx )
+{
+    applyArrays();
+    bool fixed = beforeDraw();
+    glDrawElements( mode, count, type, idx );
+    afterDraw( fixed );
+}
+
+// A buffer KiCad deletes is forgotten here, so it is never bound again (the desktop unbinds it the same way).
+void kg_DeleteBuffers( GLsizei n, const GLuint* ids )
+{
+    STATE& s = S();
+
+    for( GLsizei i = 0; i < n; i++ )
+    {
+        if( ids[i] == 0 )
+            continue;
+
+        for( ARRAY& r : s.arrays )
+        {
+            if( r.buffer == ids[i] )
+                r = ARRAY();
+        }
+
+        if( s.arrayBuffer == ids[i] )
+            s.arrayBuffer = 0;
+    }
+
+    forgetBuffers( n, ids );
+    glDeleteBuffers( n, ids );
+}
+
+// ── display lists ──
+GLuint kg_GenLists( GLsizei n )
+{
+    STATE& s = S();
+    GLuint base = s.nextList;
+    s.nextList += n;
+
+    for( GLsizei i = 0; i < n; i++ )
+        s.lists[base + i];              // reserved names are lists (empty), as on the desktop
+
+    return base;
+}
+
+GLboolean kg_IsList( GLuint l )
+{
+    return l != 0 && S().lists.count( l ) ? GL_TRUE : GL_FALSE;
+}
+
+void freeList( DLIST& d )
+{
+    if( !d.buffers.empty() )
+    {
+        forgetBuffers( (GLsizei) d.buffers.size(), d.buffers.data() );
+        glDeleteBuffers( (GLsizei) d.buffers.size(), d.buffers.data() );
+    }
+
+    d.buffers.clear();
+    d.calls.clear();
+}
+
+void kg_NewList( GLuint l, GLenum mode )
+{
+    STATE& s = S();
+
+    if( l == 0 || s.rec )
+        return;
+
+    DLIST& d = s.lists[l];
+    freeList( d );
+    s.rec = &d;
+    s.recExec = mode == KG_COMPILE_AND_EXECUTE;
+    memcpy( s.recSaved[0], s.col, sizeof s.col );
+    memcpy( s.recSaved[1], s.tex, sizeof s.tex );
+    memcpy( s.recSaved[2], s.nrm, sizeof s.nrm );
+}
+
+void kg_EndList()
+{
+    STATE& s = S();
+
+    if( !s.rec )
+        return;
+
+    s.rec = nullptr;
+
+    if( !s.recExec )                    // GL_COMPILE leaves the current colour, texture coordinate and normal alone
+    {
+        memcpy( s.col, s.recSaved[0], sizeof s.col );
+        memcpy( s.tex, s.recSaved[1], sizeof s.tex );
+        memcpy( s.nrm, s.recSaved[2], sizeof s.nrm );
+    }
+
+    s.recExec = false;
+}
+
+void kg_CallList( GLuint l )
+{
+    KG_RECORD( kg_CallList( l ) );
+    auto it = S().lists.find( l );
+
+    if( it == S().lists.end() )
+        return;
+
+    for( const std::function<void()>& f : it->second.calls )
+        f();
+}
+
+void kg_DeleteLists( GLuint l, GLsizei range )
+{
+    STATE& s = S();
+
+    for( GLsizei i = 0; i < range; i++ )
+    {
+        auto it = s.lists.find( l + i );
+
+        if( it != s.lists.end() && &it->second != s.rec )
+        {
+            freeList( it->second );
+            s.lists.erase( it );
+        }
+    }
+}
