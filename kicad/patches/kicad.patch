+    if( recording() )
+        S().rec->calls.push_back( [=]() { setCol( r, g, b, a ); } );
+
+    S().col[0] = r;
+    S().col[1] = g;
+    S().col[2] = b;
+    S().col[3] = a;
+}
+
+void kg_Color4f( GLfloat r, GLfloat g, GLfloat b, GLfloat a ) { setCol( r, g, b, a ); }
+void kg_Color4d( GLdouble r, GLdouble g, GLdouble b, GLdouble a ) { setCol( r, g, b, a ); }
+void kg_Color3f( GLfloat r, GLfloat g, GLfloat b ) { setCol( r, g, b, 1 ); }
+void kg_Color3d( GLdouble r, GLdouble g, GLdouble b ) { setCol( r, g, b, 1 ); }
+void kg_Color4ub( GLubyte r, GLubyte g, GLubyte b, GLubyte a ) { setCol( r / 255.f, g / 255.f, b / 255.f, a / 255.f ); }
+void kg_Color4fv( const GLfloat* v ) { setCol( v[0], v[1], v[2], v[3] ); }
