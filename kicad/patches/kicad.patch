+}
+
+bool identChar( char c )
+{
+    return ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' ) || ( c >= '0' && c <= '9' ) || c == '_';
+}
+
+// Replace whole identifiers (or tokens starting with one) only.
+void replaceIdent( std::string& s, const std::string& from, const std::string& to )
+{
+    size_t pos = 0;
+
+    while( ( pos = s.find( from, pos ) ) != std::string::npos )
+    {
+        bool startOk = pos == 0 || !identChar( s[pos - 1] );
+        bool endOk = !identChar( from.back() ) || pos + from.size() >= s.size() || !identChar( s[pos + from.size()] );
+
+        if( startOk && endOk )
+        {
+            s.replace( pos, from.size(), to );
+            pos += to.size();
+        }
+        else
+        {
+            pos += from.size();
+        }
+    }
+}
+
+std::string toEs( std::string src, bool vertex )
+{
+    size_t v = src.find( "#version" );
+
+    if( v == std::string::npos )
+        return src;
+
+    size_t eol = src.find( '\n', v );
+    std::string ver = src.substr( v, eol == std::string::npos ? std::string::npos : eol - v );
+
+    if( ver.find( "es" ) != std::string::npos )
+        return src; // already GLSL ES
+
+    src.erase( v, eol == std::string::npos ? std::string::npos : eol - v );
+
+    std::string head = "#version 300 es\nprecision highp float;\nprecision highp int;\n";
+
+    if( vertex )
+    {
+        head += "in vec4 kg_Vertex;\nin vec4 kg_Color;\nin vec4 kg_MultiTexCoord0;\nuniform mat4 kg_MVP;\n"
+                "out vec4 kg_FrontColor;\nout vec4 kg_TexCoord0;\n";
+        replaceIdent( src, "attribute", "in" );
+        replaceIdent( src, "varying", "out" );
+        replaceIdent( src, "ftransform()", "(kg_MVP * kg_Vertex)" );
+        replaceIdent( src, "gl_Vertex", "kg_Vertex" );
+        replaceIdent( src, "gl_Color", "kg_Color" );
+        replaceIdent( src, "gl_MultiTexCoord0", "kg_MultiTexCoord0" );
+        replaceIdent( src, "gl_FrontColor", "kg_FrontColor" );
+    }
+    else
+    {
+        head += "in vec4 kg_FrontColor;\nin vec4 kg_TexCoord0;\nout vec4 kg_FragColor;\n";
+        replaceIdent( src, "varying", "in" );
+        replaceIdent( src, "gl_Color", "kg_FrontColor" );
+        replaceIdent( src, "gl_FragColor", "kg_FragColor" );
+    }
+
+    replaceIdent( src, "gl_ModelViewProjectionMatrix", "kg_MVP" );
+    replaceIdent( src, "gl_TexCoord[0]", "kg_TexCoord0" );
+    replaceIdent( src, "texture2DLod", "textureLod" );
+    replaceIdent( src, "texture2D", "texture" );
+    return head + src;
+}
+
+void kg_ShaderSource( GLuint sh, GLsizei n, const GLchar* const* strs, const GLint* lens )
+{
+    std::string src;
+
+    for( GLsizei i = 0; i < n; i++ )
+    {
+        if( lens && lens[i] >= 0 )
+            src.append( strs[i], lens[i] );
+        else
+            src.append( strs[i] );
+    }
+
+    auto it = S().shaderTypes.find( sh );
+    bool vertex = it != S().shaderTypes.end() && it->second == GL_VERTEX_SHADER;
+    std::string es = toEs( src, vertex );
+    const char* p = es.c_str();
+    glShaderSource( sh, 1, &p, nullptr );
+}
