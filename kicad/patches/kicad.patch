+// Texture environment of unit 0: the mode (modulate, replace, or the combine the 3D models use) and its colour. The
+// combine's own sources are not read: KiCad uses one setting of it (render_3d_opengl.cpp: rgb from the lit colour,
+// alpha = lit alpha x the environment colour's alpha), which the built-in program does as "combine".
+void texEnv( GLenum pname, VEC4 v )
+{
+    KG_RECORD( texEnv( pname, v ) );
+    STATE& s = S();
+
+    if( s.activeUnit != 0 )
+        return;
+
+    if( pname == KG_TEXTURE_ENV_MODE )
+        s.envMode = (GLenum) v[0];
+    else if( pname == KG_TEXTURE_ENV_COLOR )
+        s.envColor = v;
+}
+
+void kg_TexEnvf( GLenum, GLenum pname, GLfloat v ) { texEnv( pname, VEC4{ v, 0, 0, 0 } ); }
+void kg_TexEnvi( GLenum, GLenum pname, GLint v ) { texEnv( pname, VEC4{ (float) v, 0, 0, 0 } ); }
+
+void kg_TexEnvfv( GLenum, GLenum pname, const GLfloat* v )
+{
+    texEnv( pname, pname == KG_TEXTURE_ENV_COLOR ? vec4( v, 4 ) : VEC4{ v[0], 0, 0, 0 } );
+}
