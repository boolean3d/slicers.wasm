diff --git a/include/kc_tool_thread.h b/include/kc_tool_thread.h
new file mode 100644
index 00000000..a9f5429b
--- /dev/null
+++ b/include/kc_tool_thread.h
@@ -0,0 +1,38 @@
+/*
+ * Browser build only (__EMSCRIPTEN__). KiCad's tools are coroutines; in the browser each one is a thread of its own
+ * (the spike's stubs/libcontext_threads.cpp), while the WebGL context and the wx port's JavaScript state exist only on
+ * the program's main thread. Work that touches them and is asked for by a tool (a repaint after Ctrl+A, a rotate, a
+ * delete; a layer colour change; a resize) is carried out on the main thread while the tool waits, the way the wx
+ * port's EM_ASM calls already are. On the main thread, and in every other build, these do nothing.
+ */
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+#include <type_traits>
+
+extern "C" bool kc_on_tool_thread();
+extern "C" void kc_run_on_host( void ( *aFn )( void* ), void* aArg );
+
+/// Run aWork on the main thread when called from a tool thread. Returns true when it ran there (the caller returns).
+template <typename F>
+inline bool KcRunOnMainThread( F&& aWork )
+{
+    if( !kc_on_tool_thread() )
+        return false;
+
+    using W = std::remove_reference_t<F>;
+    kc_run_on_host( []( void* aPtr ) { ( *static_cast<W*>( aPtr ) )(); }, (void*) &aWork );
+    return true;
+}
+
+#define KC_ON_MAIN_THREAD( call ) if( KcRunOnMainThread( [&]() { call; } ) ) return
+#define KC_ON_MAIN_THREAD_R( type, call )                                                                              \
+    {                                                                                                                  \
+        type kc_r{};                                                                                                   \
+        if( KcRunOnMainThread( [&]() { kc_r = call; } ) )                                                              \
+            return kc_r;                                                                                               \
+    }
+#else
+#define KC_ON_MAIN_THREAD( call )
+#define KC_ON_MAIN_THREAD_R( type, call )
+#endif
