@@ -0,0 +1,391 @@
+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/wasm/toplevel.cpp
+// Purpose:     wxTopLevelWindowWasm implementation
+// Author:      Adam Hilss
+// Copyright:   (c) 2022 Adam Hilss
+// Licence:     LGPL v2
+/////////////////////////////////////////////////////////////////////////////
+
+#include "wx/wxprec.h"
+
+#include "wx/app.h"
+#include "wx/dcclient.h"
+#include "wx/frame.h"
+#include "wx/settings.h"
+#include "wx/toplevel.h"
+#include "wx/containr.h"
+#include "wx/weakref.h"
+#include <map>
+
+#include "wx/wasm/private.h"
+#include "wx/wasm/private/display.h"
+
+#include <emscripten.h>
+extern "C" void wxpage_fullscreen(int on);
+extern "C" void wxpage_set_icon_image(unsigned char* rgba, int w, int h);
+#include "wx/image.h"
+#include <stdlib.h>
+extern "C" void wxpage_set_window_decorated(int id, int on);
+extern "C" void wxpage_set_title(const char* title);
+
+#include <emscripten/html5.h>
+
+static const wxCoord TITLE_BAR_HEIGHT = 30;
+static const wxColour TITLE_BAR_BACKGROUND_COLOUR(0xeb, 0xeb, 0xeb);
+static const wxColour TITLE_BAR_FOREGROUND_COLOUR(0x2e, 0x34, 0x36);
+static const wxColour TITLE_BAR_LINE_COLOUR(0xd5, 0xd0, 0xcc);
+
+static const wxCoord MINIMIZE_BUTTON_SIZE = 22;
+static const wxCoord MINIMIZE_BUTTON_PADDING = 7;
+
+// ----------------------------------------------------------------------------
+// wxTopLevelWindowWasm
+// ----------------------------------------------------------------------------
+
+wxBEGIN_EVENT_TABLE(wxTopLevelWindowWasm, wxTopLevelWindowBase)
+    EVT_NC_PAINT(wxTopLevelWindowWasm::OnNcPaint)
+    EVT_LEFT_DOWN(wxTopLevelWindowWasm::OnMouseDown)
+    EVT_LEFT_UP(wxTopLevelWindowWasm::OnMouseUp)
+    EVT_MOTION(wxTopLevelWindowWasm::OnMotion)
+wxEND_EVENT_TABLE()
+
+bool wxTopLevelWindowWasm::Create(wxWindow *parent,
+                                  wxWindowID id,
+                                  const wxString& title,
+                                  const wxPoint& pos,
+                                  const wxSize& size,
+                                  long style,
+                                  const wxString& name)
+{
+    //wxLogDebug(wxT("creating toplevel window"));
+
+    // z35: no size given = the desktop default size (wxMSW/wxGTK: size.SetDefaults(GetDefaultSize())), not 20 x 20
+    wxSize sizeReal(size);
+    if (!sizeReal.IsFullySpecified())
+        sizeReal.SetDefaults(GetDefaultSize());
+
+    if (!wxTopLevelWindowBase::Create(parent, id, pos, sizeReal, style, name))
+    {
+        wxFAIL_MSG(wxT("wxTopLevelWindowWasm creation failed"));
+        return false;
+    }
+
+    // the border the caller asked for (the base Create stored the default one, wxBORDER_NONE, in its place)
+    m_windowStyle = (m_windowStyle & ~wxBORDER_MASK) | (style & wxBORDER_MASK);
+
+    SetTitle(title);
+
+    // the frame (edge and shadow) of a decorated window, drawn by the page around the window's element
+    wxpage_set_window_decorated(GetCSSId(), HasTitleBar());
+
+    return true;
+}
+
+void wxTopLevelWindowWasm::Init()
+{
+    m_isActive = false;
+    m_minimizeButtonRect = wxRect(0, 0, MINIMIZE_BUTTON_SIZE, MINIMIZE_BUTTON_SIZE);
+    m_isDragging = false;
+}
+
+bool wxTopLevelWindowWasm::HasTitleBar() const
+{
+    // Main frame already has a native title bar (the browser's). Others as wxGTK: decorated with wxCAPTION unless
+    // borderless.
+    const long style = GetWindowStyle();
+    return !IsMainFrame() && (style & wxCAPTION) && !(style & (wxNO_BORDER | wxSIMPLE_BORDER));
+}
+
+wxPoint wxTopLevelWindowWasm::GetClientAreaOrigin() const
+{
+    wxPoint origin = wxTopLevelWindowBase::GetClientAreaOrigin();
+
+    if (HasTitleBar())
+    {
+        origin.y += TITLE_BAR_HEIGHT;
+    }
+
+    return origin;
+}
+
+void wxTopLevelWindowWasm::DoGetClientSize(int *width, int *height) const
+{
+    wxTopLevelWindowBase::DoGetClientSize(width, height);
+
+    if (height && HasTitleBar())
+    {
+        *height = wxMax(*height - TITLE_BAR_HEIGHT, 0);
+    }
+}
+
+void wxTopLevelWindowWasm::DoSetClientSize(int width, int height)
+{
+    if (HasTitleBar())
+    {
+        height += TITLE_BAR_HEIGHT;
+    }
+
+    wxTopLevelWindowBase::DoSetClientSize(width, height);
+}
+
+void wxTopLevelWindowWasm::DoScreenToClient(int *x, int *y) const
+{
+    wxWindow::DoScreenToClient(x, y);
+}
+
+void wxTopLevelWindowWasm::DoClientToScreen(int *x, int *y) const
+{
+    wxWindow::DoClientToScreen(x, y);
+}
+
+void wxTopLevelWindowWasm::SetIcons(const wxIconBundle& icons)
+{
+    wxTopLevelWindowBase::SetIcons(icons);
+
+    wxSize size = wxContentScaleFactor() >= 1.5 ? wxSize(32, 32) : wxSize(16, 16);
+
+    wxIcon icon = icons.GetIcon(size, wxIconBundle::FALLBACK_NEAREST_LARGER);
+
+    if (icon.IsOk())
+    {
+        // the favicon (phase 2c): pixels to the page, which makes the PNG (wxpage.js); the page frees rgba
+        wxBitmap bmp; bmp.CopyFromIcon(icon);
+        const wxImage img = bmp.ConvertToImage();
+        const int w = img.GetWidth(), h = img.GetHeight();
+        if (!img.IsOk() || w <= 0 || h <= 0 || w > 256 || h > 256) return;
+        unsigned char* rgba = (unsigned char*)malloc((size_t)w * h * 4);
+        if (!rgba) return;
+        const unsigned char* rgb = img.GetData();
+        const unsigned char* alpha = img.HasAlpha() ? img.GetAlpha() : NULL;
+        for (int i = 0; i < w * h; i++)
+        {
+            rgba[i * 4] = rgb[i * 3]; rgba[i * 4 + 1] = rgb[i * 3 + 1]; rgba[i * 4 + 2] = rgb[i * 3 + 2];
+            rgba[i * 4 + 3] = alpha ? alpha[i] : (img.HasMask() && img.IsTransparent(i % w, i / w) ? 0 : 255);
+        }
+        wxpage_set_icon_image(rgba, w, h);
+    }
+}
+
+// z48: the active top-level window (a weak reference: a destroyed window is simply no longer active)
+static wxWeakRef<wxTopLevelWindowWasm> gs_activeTopLevel;
+
+static void PostActivate(wxTopLevelWindowWasm *tlw, bool active)
+{
+    wxActivateEvent event(wxEVT_ACTIVATE, active, tlw->GetId());
+    event.SetEventObject(tlw);
+    tlw->GetEventHandler()->AddPendingEvent(event);
+}
+
+void wxTopLevelWindowWasm::Activate(wxTopLevelWindowWasm *tlw)
+{
+    wxTopLevelWindowWasm *old = gs_activeTopLevel.get();
+    if ( old == tlw )
+        return;
+    gs_activeTopLevel = tlw;
+    if ( old )
+    {
+        old->SetActive(false);
+        PostActivate(old, false);
+    }
+    if ( tlw )
+    {
+        tlw->SetActive(true);
+        PostActivate(tlw, true);
+    }
+}
+
+// Where the keyboard was before each shown window took it (given back when that window hides).
+static std::map<wxTopLevelWindowWasm *, wxWeakRef<wxWindow> > gs_focusBeforeShow;
+static bool gs_showWithoutActivating = false;
+
+bool wxTopLevelWindowWasm::Show(bool show)
+{
+    wxWindow *focus = wxWindow::FindFocus();
+    const bool focusInside = focus && wxGetTopLevelParent(focus) == this;
+    if ( !wxTopLevelWindowBase::Show(show) )
+        return false;
+
+    if ( show )
+    {
+        if ( !gs_showWithoutActivating )
+            Activate(this);   // z48
+        if ( !gs_showWithoutActivating && !focusInside )
+        {
+            gs_focusBeforeShow[this] = focus;
+            if ( !wxSetFocusToChild(this, NULL) )
+                SetFocus();
+        }
+    }
+    else
+    {
+        auto it = gs_focusBeforeShow.find(this);
+        wxWindow *back = it != gs_focusBeforeShow.end() ? it->second.get() : NULL;
+        if ( it != gs_focusBeforeShow.end() )
+            gs_focusBeforeShow.erase(it);
+        if ( focusInside && back && back->IsShownOnScreen() )
+            back->SetFocus();
+        // z48: the window the keyboard went back to is active, else the main frame
+        if ( gs_activeTopLevel.get() == this )
+        {
+            wxWindow *next = back && back->IsShownOnScreen() ? wxGetTopLevelParent(back) : wxTheApp->GetTopWindow();
+            wxTopLevelWindowWasm *tlw = dynamic_cast<wxTopLevelWindowWasm *>(next);
+            Activate(tlw && tlw != this && tlw->IsShown() ? tlw : NULL);
+        }
+    }
+    return true;
+}
+
+void wxTopLevelWindowWasm::ShowWithoutActivating()
+{
+    gs_showWithoutActivating = true;
+    Show(true);
+    gs_showWithoutActivating = false;
+}
+
+bool wxTopLevelWindowWasm::ShowFullScreen(bool show, long WXUNUSED(style))
+{
+    if (show != IsFullScreen())
+    {
+        wxpage_fullscreen(show ? 1 : 0);
+    }
+
+    return true;
+}
+
+bool wxTopLevelWindowWasm::IsFullScreen() const
+{
+    return EM_ASM_INT({ return wxFullscreen; }) != 0;
+}
+
+void wxTopLevelWindowWasm::SetTitle(const wxString &title)
+{
+    m_title = title;
+
+    if (IsMainFrame())
+    {
+        wxpage_set_title(static_cast<const char *>(title.utf8_str()));
+    }
+}
+
+void wxTopLevelWindowWasm::DrawTitleText(wxDC& dc, const wxRect& rect)
+{
+    wxFont font = wxSystemSettings::GetFont(wxSYS_DEFAULT_GUI_FONT).Bold();
+
+    wxCoord textWidth;
+    wxCoord textHeight;
+    dc.GetTextExtent(GetTitle(), &textWidth, &textHeight, NULL, NULL, &font);
+
+    int textX = wxMax((rect.width - textWidth) / 2, 0);
+    int textY = wxMax((rect.height - textHeight) / 2, 0);
+
+    dc.SetTextBackground(TITLE_BAR_BACKGROUND_COLOUR);
+    dc.SetTextForeground(TITLE_BAR_FOREGROUND_COLOUR);
+    dc.SetFont(font);
+
+    dc.DrawText(GetTitle(), textX, textY);
+}
+
+void wxTopLevelWindowWasm::DrawMinimizeButton(wxDC& dc, const wxRect& rect)
+{
+    wxCoord buttonWidth = m_minimizeButtonRect.width - 2 * MINIMIZE_BUTTON_PADDING;
+    wxCoord buttonHeight = m_minimizeButtonRect.height - 2 * MINIMIZE_BUTTON_PADDING;
+    wxCoord buttonMargin = (rect.height - buttonHeight) / 2;
+
+    wxCoord buttonX = wxMax(rect.x + rect.width - buttonWidth - buttonMargin, 0);
+    wxCoord buttonY = rect.y + buttonMargin;
+
+    m_minimizeButtonRect.x = buttonX - MINIMIZE_BUTTON_PADDING;
+    m_minimizeButtonRect.y = buttonY - MINIMIZE_BUTTON_PADDING;
+
+    dc.SetPen(wxPen(TITLE_BAR_FOREGROUND_COLOUR, 1));
+
+    dc.DrawLine(buttonX, buttonY, buttonX + buttonWidth, buttonY + buttonHeight);
+    dc.DrawLine(buttonX, buttonY + buttonHeight, buttonX + buttonWidth, buttonY);
+}
+
+void wxTopLevelWindowWasm::StartDrag(const wxPoint& pos)
+{
+    m_isDragging = true;
+    m_dragOffset = pos;
+    CaptureMouse();
+}
+
+void wxTopLevelWindowWasm::EndDrag()
+{
+    m_isDragging = false;
+    ReleaseMouse();
+}
+
+void wxTopLevelWindowWasm::DragMove(const wxPoint& pos)
+{
+    Move(pos - m_dragOffset);
+}
+
+void wxTopLevelWindowWasm::OnNcPaint(wxNcPaintEvent& WXUNUSED(event))
+{
+    if (HasTitleBar())
+    {
+        wxWindowDC dc(this);
+        wxRect ncRect(0, 0, GetSize().x, TITLE_BAR_HEIGHT);
+
+        dc.SetBrush(TITLE_BAR_BACKGROUND_COLOUR);
+        dc.SetPen(*wxTRANSPARENT_PEN);
+
+        dc.DrawRectangle(ncRect);
+
+        dc.SetPen(wxPen(TITLE_BAR_LINE_COLOUR, 1));
+        dc.DrawLine(0, TITLE_BAR_HEIGHT - 1, ncRect.width, TITLE_BAR_HEIGHT - 1);
+
+        DrawTitleText(dc, ncRect);
+        if (GetWindowStyle() & wxCLOSE_BOX)
+            DrawMinimizeButton(dc, ncRect);
+        else
+            m_minimizeButtonRect = wxRect();
+    }
+}
+
+void wxTopLevelWindowWasm::OnMouseDown(wxMouseEvent& event)
+{
+    if (HasTitleBar())
+    {
+        wxPoint pos = event.GetPosition() + GetClientAreaOrigin();
+
+        if (pos.y < TITLE_BAR_HEIGHT && !m_minimizeButtonRect.Contains(pos))
+        {
+            StartDrag(pos);
+        }
+    }
+}
+
+void wxTopLevelWindowWasm::OnMouseUp(wxMouseEvent& event)
+{
+    if (m_isDragging)
+    {
+        EndDrag();
+    }
+
+    if (HasTitleBar())
+    {
+        wxPoint pos = event.GetPosition() + GetClientAreaOrigin();
+
+        if (m_minimizeButtonRect.Contains(pos))
+        {
+            Close();
+        }
+    }
+}
+
+void wxTopLevelWindowWasm::OnMotion(wxMouseEvent& event)
+{
+    if (m_isDragging)
+    {
+        if (event.Dragging())
+        {
+            DragMove(ClientToScreen(event.GetPosition()));
+        }
+        else
+        {
+            EndDrag();
+        }
+    }
+}
