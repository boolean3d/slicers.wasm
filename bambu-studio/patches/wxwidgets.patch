+bool wxApp::IsKeyPressed(long keyCode)
+{
+    switch (keyCode)
+    {
+        case WXK_NONE:
+            return false;
+            break;
+        case WXK_CONTROL:
+            return m_mouseState.RawControlDown();
+            break;
+        case WXK_SHIFT:
+            return m_mouseState.ShiftDown();
+            break;
+        case WXK_ALT:
+            return m_mouseState.AltDown();
+            break;
+        default:
+            return m_keyCodeSet.find(keyCode) != m_keyCodeSet.end();
+            break;
+    }
+}
