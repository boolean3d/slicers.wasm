+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/wasm/nonownedwnd.h
+// Purpose:
+// Author:      Adam Hilss
+// Copyright:   (c) 2019 Adam Hilss
+// Licence:     LGPL v2
+/////////////////////////////////////////////////////////////////////////////
+
+#ifndef _WX_WASM_NONOWNEDWND_H_
+#define _WX_WASM_NONOWNEDWND_H_
+
+#include <queue>
+
+class WXDLLIMPEXP_CORE wxNonOwnedWindow : public wxNonOwnedWindowBase
+{
+public:
+    // construction
+    wxNonOwnedWindow() { Init(); }
+    wxNonOwnedWindow(wxWindow *parent,
+                     wxWindowID id,
+                     const wxPoint& pos = wxDefaultPosition,
+                     const wxSize& size = wxDefaultSize,
+                     long style = 0,
+                     const wxString& name = wxPanelNameStr)
+    {
+        Init();
+        Create(parent, id, pos, size, style, name);
+    }
+
+    bool Create(wxWindow *parent,
+                wxWindowID id,
+                const wxPoint& pos = wxDefaultPosition,
+                const wxSize& size = wxDefaultSize,
+                long style = 0,
+                const wxString& name = wxPanelNameStr);
+
+    virtual ~wxNonOwnedWindow();
+
+    virtual bool Show(bool show = true) wxOVERRIDE;
+
+    virtual void Raise() wxOVERRIDE;
+    virtual void Lower() wxOVERRIDE;
+
+    virtual void SetSizer(wxSizer *sizer, bool deleteOld = true);
+
+    virtual wxString GetCSSClassList() const { return "window"; }
+
+    // The frame that fills the page (see GetMainFrame)
+    bool IsMainFrame() const;
+    // The app's top window if it is a frame that belongs on the taskbar, else the first such frame; NULL if none
+    static wxNonOwnedWindow* GetMainFrame();
+
+    int GetCSSId() const { return m_cssId; }
+
+    // the page element's id once created (never 0: ids start at 1), NULL before: as wxGTK's GtkWidget, it tells
+    // a created window (delayed Destroy, wxDisplay::GetFromWindow, destroy event)
+    virtual WXWidget GetHandle() const wxOVERRIDE
+        { return m_cssId != wxID_NONE ? reinterpret_cast<WXWidget>(static_cast<wxIntPtr>(m_cssId)) : NULL; }
+
+    void HandlePaintRequests();
+
+protected:
+    virtual void DoSetSize(int x, int y,
+                           int width, int height,
+                           int sizeFlags = wxSIZE_AUTO) wxOVERRIDE;
+
+    virtual void OnAnimationFrame() {}
+
+    void SetCSSId(int cssId) { m_cssId = cssId; }
+
+private:
+    void Init();
+
+    int m_cssId;
+
+    friend class wxApp;
+};
+
+#endif // _WX_WASM_NONOWNEDWND_H_
