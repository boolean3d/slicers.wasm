+#ifdef __EMSCRIPTEN__
+// Off-thread (phase 2e): every file call from the worker is a round trip to the page's file system, so an image file is
+// read whole in one call instead of through the 1 KB stream buffer (4,530 reads for 522 files at start-up). Returns
+// false when the file cannot be read that way; the caller then takes the stream path.
+static bool wxWasmImageWhole(const wxString& filename, wxMemoryBuffer& buf)
+{
+    wxFile f(filename);
+    if ( !f.IsOpened() )
+        return false;
+    const wxFileOffset len = f.Length();
+    if ( len <= 0 || len > (wxFileOffset)(256 * 1024 * 1024) )
+        return false;
+    buf.SetBufSize((size_t)len);
+    const ssize_t got = f.Read(buf.GetData(), (size_t)len);
+    if ( got != (ssize_t)len )
+        return false;
+    buf.SetDataLen((size_t)len);
+    return true;
+}
+#endif // __EMSCRIPTEN__
+
