+const char* GetFamilyString(wxFontFamily family)
+{
+    switch (family)
+    {
+        case wxFONTFAMILY_DEFAULT:
+            return "\"Noto Sans\", sans-serif";
+            break;
+        case wxFONTFAMILY_DECORATIVE:
+            return "cursive";
