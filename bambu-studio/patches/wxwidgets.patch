@@ -0,0 +1,141 @@
+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/wasm/evtloop.cpp
+// Purpose:     wxGUIEventLoop implementation
+// Author:      Adam Hilss
+// Copyright:   (c) 2022 Adam Hilss
+// Licence:     LGPL v2
+/////////////////////////////////////////////////////////////////////////////
+
+#include "wx/wxprec.h"
+
+#include "wx/app.h"
+#include "wx/evtloop.h"
+#include "wx/toplevel.h"
+
+#include <emscripten.h>
+
+EM_ASYNC_JS(void, wxWasmWaitFrame, (), {
+    await new Promise(resolve => requestAnimationFrame(() => resolve()));
+});
+
+EM_ASYNC_JS(void, wxWasmYieldToBrowser, (), {
+    await new Promise(resolve => setTimeout(resolve, 0));
+});
+
+bool wxWasmInPress();                   // app.cpp (z15)
+int wxWasmSetDeferUserInput(int defer);
+
+extern "C" {
+
+    void EMSCRIPTEN_KEEPALIVE ProcessEvents()
+    {
+        static int counter = 0;
+
+        wxWasmDispatchInput();
+
+        if (wxTheApp)
+        {
+            wxTheApp->ProcessPendingEvents();
+            wxTheApp->Paint();
+            if (counter++ % 3 == 0)
+            {
+                wxTheApp->ProcessIdle();
+            }
+        }
+    }
+
+}  // extern "C"
+
+// ----------------------------------------------------------------------------
+// wxGUIEventLoop
+// ----------------------------------------------------------------------------
+
+void wxGUIEventLoop::ScheduleExit(int rc)
+{
+    m_exitCode = rc;
+    m_shouldExit = true;
+}
+
+bool wxGUIEventLoop::Pending() const
+{
+    return wxTheApp && wxTheApp->HasPendingEvents();
+}
+
+bool wxGUIEventLoop::Dispatch()
+{
+    ProcessEvents();
+    return true;
+}
+
+int wxGUIEventLoop::DispatchTimeout(unsigned long WXUNUSED(timeout))
+{
+    // TODO: implement
+    wxFAIL_MSG(wxT("DispatchTimeout is not implemented"));
+    return 0;
+}
+
+void wxGUIEventLoop::WakeUp()
+{
+    // noop: browser doesn't block
+}
+
+void wxGUIEventLoop::DoYieldFor(long eventsToProcess)
+{
+    // inside a button press handler (or asked to leave input out) the next mouse/key events wait for it to end (z15)
+    const bool defer = wxWasmInPress() || !(eventsToProcess & wxEVT_CATEGORY_USER_INPUT);
+    const int oldDefer = defer ? wxWasmSetDeferUserInput(1) : -1;
+    while (Pending())
+    {
+        Dispatch();
+    }
+    if (defer)
+        wxWasmSetDeferUserInput(oldDefer);
+
+    wxEventLoopBase::DoYieldFor(eventsToProcess);
+
+    // Let the browser run (worker messages, timers) while code polls with wxYield().
+    wxWasmYieldToBrowser();
+}
+
+void wxGUIEventLoop::FitTopWindow()
+{
+    if (!wxTopLevelWindows.empty())
+    {
+        wxWindow *topWindow = wxTopLevelWindows.front();
+
+        int width = EM_ASM_INT({
+            return window.innerWidth;
+        });
+        int height = EM_ASM_INT({
+            return window.innerHeight - mainWindow.offsetTop;
+        });
+        topWindow->SetSize(0, 0, width, height);
+        topWindow->Refresh();
+    }
+}
+
+int wxGUIEventLoop::DoRun()
+{
+    wxASSERT_MSG(IsOk(), wxT("invalid event loop"));
+
+    static int s_depth = 0;
+    if (s_depth++ == 0)
+        FitTopWindow();
+
+    // a modal loop takes input even when it was started from a yield (z15)
+    const int oldDefer = wxWasmSetDeferUserInput(0);
+
+    // A real loop: the stack (and everything wxEntry keeps on it) stays alive, and
+    // a modal loop nests like on the desktop. Each pass hands the thread back to the
+    // browser until the next animation frame (JSPI suspends the wasm stack).
+    while (!m_shouldExit)
+    {
+        ProcessEvents();
+        if (!m_shouldExit)
+            wxWasmWaitFrame();
+    }
+
+    wxWasmSetDeferUserInput(oldDefer);
+    s_depth--;
+    return m_exitCode;
+}
