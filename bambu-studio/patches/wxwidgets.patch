+bool wxWindowWasm::Show(bool show)
+{
+    if (wxWindowBase::Show(show))
+    {
+        if (!IsTopLevel() && GetParent() != NULL)
+        {
+            GetParent()->InvalidateBestSize();
+            s_relayoutPending.push_back(GetParent());
+        }
+        if (show)
+        {
+            Refresh();
+        }
+        else if (GetParent())
+        {
+            GetParent()->Refresh();
+        }
+
+        wxShowEvent eventShow(GetId(), show);
+        eventShow.SetEventObject(this);
+        HandleWindowEvent(eventShow);
+
+        return true;
+    }
+    else
+    {
+        return false;
+    }
+}
