+bool wxBitmap::LoadFile(const wxString &filename, wxBitmapType type)
+{
+    // As wxGTK: any file wxImage reads. The default type (XPM) also tries the file's own format.
+    UnRef();
+    wxImage image;
+    if (!image.LoadFile(filename, type) &&
+        !(type == wxBITMAP_TYPE_XPM && image.LoadFile(filename, wxBITMAP_TYPE_ANY)))
