+wxNonOwnedWindow* wxWindowWasm::GetTopLevelWindow()
+{
+    wxWindowWasm* window = this;
+
+    while (!window->IsTopLevel())
+    {
+        window = window->GetParent();
+    }
+
+    return static_cast<wxNonOwnedWindow*>(window);
