+// ----------------------------------------------------------------------------
+// Input forwarded by the page (wxpage.js) as messages; wx.js wxInputFromPage calls these on this thread.
+// They rebuild the Emscripten event structs and hand them to the same queueing callbacks as before.
+// ----------------------------------------------------------------------------
+#include <string.h>
+
+static wxApp* wxWasmApp() { return static_cast<wxApp*>(wxApp::GetInstance()); }
+static char s_keyBuf[64];
+
+static void FillMouse(EmscriptenMouseEvent& m, double ts, int sx, int sy, int cx, int cy, int mx, int my, int button, int buttons, int mods)
+{
+    memset(&m, 0, sizeof m);
+    m.timestamp = ts;
+    m.screenX = sx; m.screenY = sy; m.clientX = cx; m.clientY = cy;
+    m.ctrlKey = mods & 1; m.shiftKey = mods & 2; m.altKey = mods & 4; m.metaKey = mods & 8;
+    m.button = button; m.buttons = buttons;
+    m.movementX = mx; m.movementY = my;
+    m.targetX = cx; m.targetY = cy;   // the document was the target: targetX == clientX
+    m.canvasX = cx; m.canvasY = cy;
+}
+
+extern "C" {
+
+char* EMSCRIPTEN_KEEPALIVE wxWasmKeyBuf() { return s_keyBuf; }
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInMouse(int type, double ts, int sx, int sy, int cx, int cy, int mx, int my, int button, int buttons, int mods)
+{
+    static const int types[] = { 0, EMSCRIPTEN_EVENT_MOUSEDOWN, EMSCRIPTEN_EVENT_MOUSEUP, EMSCRIPTEN_EVENT_MOUSEMOVE,
+                                 EMSCRIPTEN_EVENT_MOUSEENTER, EMSCRIPTEN_EVENT_MOUSELEAVE };
+    if (type < 1 || type > 5 || !wxWasmApp()) return;
+    EmscriptenMouseEvent m;
+    FillMouse(m, ts, sx, sy, cx, cy, mx, my, button, buttons, mods);
+    MouseCallback(types[type], &m, wxWasmApp());
+}
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInWheel(double ts, int sx, int sy, int cx, int cy, int button, int buttons, int mods, double dx, double dy, double dz, int mode)
+{
+    if (!wxWasmApp()) return;
+    EmscriptenWheelEvent w;
+    memset(&w, 0, sizeof w);
+    FillMouse(w.mouse, ts, sx, sy, cx, cy, 0, 0, button, buttons, mods);
+    w.deltaX = dx; w.deltaY = dy; w.deltaZ = dz; w.deltaMode = mode;
+    WheelCallback(EMSCRIPTEN_EVENT_WHEEL, &w, wxWasmApp());
+}
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInKey(int type, double ts, int keyCode, int which, int charCode, int location, int repeat, int mods)
+{
+    if (!wxWasmApp()) return;
+    EmscriptenKeyboardEvent k;
+    memset(&k, 0, sizeof k);
+    k.timestamp = ts;
+    k.location = location;
+    k.ctrlKey = mods & 1; k.shiftKey = mods & 2; k.altKey = mods & 4; k.metaKey = mods & 8;
+    k.repeat = repeat;
+    k.charCode = charCode; k.keyCode = keyCode; k.which = which;
+    strncpy(k.key, s_keyBuf, sizeof k.key - 1);
+    strncpy(k.code, s_keyBuf + 32, sizeof k.code - 1);
+    s_keyFlagsIn = mods & (wxWASM_KEY_TEXT | wxWASM_KEY_COMPOSING);
+    KeyCallback(type == 1 ? EMSCRIPTEN_EVENT_KEYDOWN : EMSCRIPTEN_EVENT_KEYUP, &k, wxWasmApp());
+    s_keyFlagsIn = 0;
+}
+
+// Text the browser produced (wxpage.js: beforeinput insertText in the hidden text box): one wxEVT_CHAR per code point,
+// as a desktop toolkit sends chars after a key down. Knows every character (dead keys, AltGr, accents, an emoji or touch
+// keyboard), where the char synthesised from keydown knew ASCII only.
+static void wxWasmSendChars(const wxString& text)
+{
+    wxApp* app = wxWasmApp();
+    for (wxString::const_iterator it = text.begin(); it != text.end(); ++it)
+    {
+        const wxUniChar c = *it;
+        if (c == '\n' || c == '\r') continue;   // Enter is a key, never text here
+        wxKeyEvent ev(wxEVT_CHAR);
+        const int code = (int)c.GetValue();
+        ev.m_keyCode = code < 128 ? code : WXK_NONE;
+#if wxUSE_UNICODE
+        ev.m_uniChar = c;
+#endif
+        ev.SetTimestamp(0);
+        app->HandleKeyEvent(&ev);
+    }
+}
+
+// one key the program sees as pressed and released (the composition's backspaces)
+static void wxWasmPressKey(const char* key, const char* code, int keyCode)
+{
+    EmscriptenKeyboardEvent k;
+    memset(&k, 0, sizeof k);
+    strncpy(k.key, key, sizeof k.key - 1);
+    strncpy(k.code, code, sizeof k.code - 1);
+    k.keyCode = k.which = keyCode;
+    KeyCallbackNow(EMSCRIPTEN_EVENT_KEYDOWN, &k, wxWasmApp());
+    KeyCallbackNow(EMSCRIPTEN_EVENT_KEYUP, &k, wxWasmApp());
+}
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInText(const char* utf8)
+{
+    if (!wxWasmApp()) return;
+    const wxString text = wxString::FromUTF8(utf8);
+    wxWasmQueueUserInput([=]() {
+        if (s_textTaken) { s_textTaken = false; return; }   // the key down before it was handled: no char, as on desktop
+        wxWasmSendChars(text);
+    });
+}
+
+// An IME composition (wxpage.js composition events; stage 0 start, 1 change, 2 end with the committed text). wxUniv has
+// no preedit, so the text in progress is shown as plain text at the caret: replaced on every change (backspaces, then
+// the new text) and at the end by what the IME committed (empty = cancelled).
+void EMSCRIPTEN_KEEPALIVE wxWasmInComp(int stage, const char* utf8)
+{
+    if (!wxWasmApp()) return;
+    const wxString text = wxString::FromUTF8(utf8);
+    wxWasmQueueUserInput([=]() {
+        if (stage == 0) { s_compShown = 0; return; }
+        for (size_t i = 0; i < s_compShown; i++) wxWasmPressKey("Backspace", "Backspace", 8);
+        wxWasmSendChars(text);
+        s_compShown = stage == 2 ? 0 : text.length();
+    });
+}
+
+// Touch (phase 2b): the page forwards each touch event as Emscripten's struct (wxpage.js): the points first, then the event
+static EmscriptenTouchEvent s_touch;
+void EMSCRIPTEN_KEEPALIVE wxWasmInTouchPoint(int i, int id, int cx, int cy, int sx, int sy, int changed)
+{
+    if (i < 0 || i >= 32) return;
+    EmscriptenTouchPoint& p = s_touch.touches[i];
+    memset(&p, 0, sizeof p);
+    p.identifier = id;
+    p.screenX = sx; p.screenY = sy; p.clientX = cx; p.clientY = cy;
+    p.pageX = cx; p.pageY = cy;
+    p.targetX = cx; p.targetY = cy; p.canvasX = cx; p.canvasY = cy;   // the document was the target: targetX == clientX
+    p.isChanged = changed; p.onTarget = 1;
+}
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInTouch(int type, double ts, int n, int mods)
+{
+    static const int types[] = { 0, EMSCRIPTEN_EVENT_TOUCHSTART, EMSCRIPTEN_EVENT_TOUCHEND, EMSCRIPTEN_EVENT_TOUCHMOVE, EMSCRIPTEN_EVENT_TOUCHCANCEL };
+    if (type < 1 || type > 4 || !wxWasmApp()) return;
+    s_touch.timestamp = ts;
+    s_touch.numTouches = n < 32 ? n : 32;
+    s_touch.ctrlKey = mods & 1; s_touch.shiftKey = mods & 2; s_touch.altKey = mods & 4; s_touch.metaKey = mods & 8;
+    TouchCallback(types[type], &s_touch, wxWasmApp());
+}
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInResize(int w, int h)
+{
+    if (!wxWasmApp()) return;
+    EmscriptenUiEvent u;
+    memset(&u, 0, sizeof u);
+    u.windowInnerWidth = w; u.windowInnerHeight = h;
+    ResizeCallback(EMSCRIPTEN_EVENT_RESIZE, &u, wxWasmApp());
+}
+
+void EMSCRIPTEN_KEEPALIVE wxWasmInFocus(int focus)
+{
+    if (!wxWasmApp()) return;
+    EmscriptenFocusEvent f;
+    memset(&f, 0, sizeof f);
+    FocusCallback(focus ? EMSCRIPTEN_EVENT_FOCUS : EMSCRIPTEN_EVENT_BLUR, &f, wxWasmApp());
+}
+
+}  // extern "C"
