+
+static EM_BOOL KeyCallbackNow(int eventType,
+                    const EmscriptenKeyboardEvent *emscriptenEvent,
+                    void *userData)
+{
+    //printf("KeyCallback: %d\n", eventType);
+
+    wxApp* app = static_cast<wxApp*>(userData);
+    wxKeyEvent event;
+    bool preventDefault = true;
+
+    if (EmscriptenKeyboardEventToWXEvent(eventType, *emscriptenEvent, &event))
+    {
+        /*
+                wxString key_char(event.GetUnicodeKey());
+                printf("type: %d, key_code: %d, char: %s\n",
+                       event.GetEventType(),
+                       event.GetKeyCode(),
+                       static_cast<const char*>(key_char.utf8_str()));
+        */
+
+        if (event.GetEventType() == wxEVT_KEY_DOWN)
+        {
+            wxKeyEvent charHookEvent(wxEVT_CHAR_HOOK, event);
+
+            if (!app->HandleKeyEvent(&charHookEvent) ||
+                charHookEvent.IsNextEventAllowed())
+            {
+                // The browser does not generate char events for some key codes
+                if (KeyCodeNeedsCharEvent(event.GetKeyCode()))
+                {
+                    if (!app->HandleKeyEvent(&event))
+                    {
+                        wxKeyEvent charEvent(wxEVT_CHAR, event);
+                        if (!app->HandleKeyEvent(&charEvent))
+                        {
+                            // a Tab nobody took moves the keyboard on, as the desktop toolkits do natively
+                            wxWindow *focus = wxWindow::FindFocus();
+                            if (focus && focus->IsEnabled())
+                                focus->HandleAsNavigationKey(charEvent);
+                        }
+                    }
+                }
+                else
+                {
+                    // The char event is made here from the key down: keydown is
+                    // always default-prevented, so the browser sends no keypress.
+                    const char k = emscriptenEvent->key[0];
+                    const bool ctrlLetter = emscriptenEvent->ctrlKey && !emscriptenEvent->altKey &&
+                        ((k >= 'a' && k <= 'z') || (k >= 'A' && k <= 'Z'));
+                    if (!app->HandleKeyEvent(&event) &&
+                        (!emscriptenEvent->ctrlKey || ctrlLetter) && !emscriptenEvent->metaKey &&
+                        std::strlen(emscriptenEvent->key) == 1)
+                    {
+                        wxKeyEvent charEvent;
+                        EmscriptenKeyboardEventToWXEvent(EMSCRIPTEN_EVENT_KEYPRESS, *emscriptenEvent, &charEvent);
+                        if (ctrlLetter)
+                        {
+                            // wxGTK AdjustCharEventKeyCodes: Ctrl+letter = 1..26 (WXK_CONTROL_A...)
+                            charEvent.m_keyCode = (k >= 'a' ? k - 'a' : k - 'A') + 1;
+#if wxUSE_UNICODE
+                            charEvent.m_uniChar = charEvent.m_keyCode;
+#endif
+                        }
+                        app->HandleKeyEvent(&charEvent);
+                    }
+                }
+            }
+            else
+            {
+                preventDefault = false;
+            }
+        }
+        else
+        {
+            app->HandleKeyEvent(&event);
+        }
+    }
+
+    return preventDefault;
+}
+
+static EM_BOOL MouseCallbackNow(int eventType,
+                      const EmscriptenMouseEvent *emscriptenEvent,
+                      void *userData)
+{
+    //const char *eventName = GetEventName(eventType);
+    //printf("MouseCallback: %s %d %ld %ld\n", eventName, emscriptenEvent->button, emscriptenEvent->targetX, emscriptenEvent->targetY);
+
+    wxApp* app = static_cast<wxApp*>(userData);
+    wxMouseEvent event;
+
+    if (EmscriptenMouseEventToWXEvent(eventType, *emscriptenEvent, &event))
+    {
+        app->HandleMouseEvent(&event);
+    }
+
+    return true;
+}
+
+static EM_BOOL TouchCallbackNow(int eventType,
+                      const EmscriptenTouchEvent *emscriptenEvent,
+                      void *userData)
+{
+    //const char *eventName = GetEventName(eventType);
+    //printf("TouchCallback: %s %d %ld %ld\n", eventName, emscriptenEvent->numTouches, emscriptenEvent->touches[0].targetX, emscriptenEvent->touches[0].targetY);
+
+    wxApp* app = static_cast<wxApp*>(userData);
+    wxMouseEvent event;
+
+    if (EmscriptenTouchEventToWXEvent(eventType, *emscriptenEvent, &event))
+    {
+        if (event.GetEventType() == wxEVT_LEFT_DOWN)
+        {
+            // Mirroring browser behavior, move the mouse to the new location
+            // before sending the mouse down event.
+            wxMouseEvent moveEvent(event);
+            moveEvent.SetEventType(wxEVT_MOTION);
+            moveEvent.SetLeftDown(false);
+            moveEvent.m_clickCount = 0;
+            app->HandleMouseEvent(&moveEvent);
+
+        }
+        app->HandleMouseEvent(&event);
+        return true;
+    } else {
+        return false;
+    }
+}
+
+static EM_BOOL WheelCallbackNow(int WXUNUSED(eventType),
+                      const EmscriptenWheelEvent *emscriptenEvent,
+                      void *userData)
+{
+    //printf("WheelCallback: %f %f %ld %ld\n", event->deltaX, event->deltaY, event->mouse.targetX, event->mouse.targetY);
+
+    wxApp* app = static_cast<wxApp*>(userData);
+    wxMouseEvent event;
+
+    if (EmscriptenWheelEventToWXEvent(*emscriptenEvent, wxHORIZONTAL, &event))
+    {
+    }
+
+    if (EmscriptenWheelEventToWXEvent(*emscriptenEvent, wxVERTICAL, &event))
+    {
+        app->HandleMouseWheelEvent(&event);
+    }
+
+    return true;
+}
+
+static EM_BOOL ResizeCallbackNow(int WXUNUSED(eventType),
+                       const EmscriptenUiEvent *emscriptenEvent,
+                       void *userData)
+{
+    //printf("ResizeCallback: %d %d\n", event->windowInnerWidth, event->windowInnerHeight);
+    wxApp* app = static_cast<wxApp*>(userData);
+    int offset = EM_ASM_INT({
+        return mainWindow.offsetTop;
+    });
+    wxSize size(emscriptenEvent->windowInnerWidth, emscriptenEvent->windowInnerHeight - offset);
+    wxSizeEvent event(size);
+
+    app->HandleSizeEvent(event);
+
+    return true;
+}
+
+static EM_BOOL FocusCallbackNow(int eventType,
+                      const EmscriptenFocusEvent *WXUNUSED(emscriptenEvent),
+                      void *userData)
+{
+    //printf("FocusCallback\n");
+    wxApp* app = static_cast<wxApp*>(userData);
+
+    wxActivateEvent event(wxEVT_ACTIVATE, eventType == EMSCRIPTEN_EVENT_FOCUS);
+    app->HandleActivateEvent(&event);
+
+    return true;
+}
+
+// Browser callbacks only queue: the event loop dispatches (see wxWasmQueueInput).
+EM_BOOL KeyCallback(int eventType, const EmscriptenKeyboardEvent *e, void *userData)
+{
+    if (eventType == EMSCRIPTEN_EVENT_KEYPRESS)
+        return true;    // chars come from the key down
+    const EmscriptenKeyboardEvent copy = *e;
+    // A paste key: the browser fires its paste event only when the key is not default-prevented, and only that event
+    // can read the computer's clipboard (wx/wasm/clipbrd.h). The key reaches the program after the event.
+    const char k = e->key[0];
+    const bool pasteKey = eventType == EMSCRIPTEN_EVENT_KEYDOWN && !e->altKey &&
+        (((e->ctrlKey || e->metaKey) && (k == 'v' || k == 'V') && e->key[1] == 0) ||
+         (e->shiftKey && !e->ctrlKey && !e->metaKey && std::strcmp(e->key, "Insert") == 0));
+    if (pasteKey)
+    {
+        wxWasmQueueUserInput([=]() { wxWasmTakeBrowserPaste(); KeyCallbackNow(eventType, &copy, userData); });
+        return false;
+    }
+    wxWasmQueueUserInput([=]() { KeyCallbackNow(eventType, &copy, userData); });
+    return true;
+}
+
+// GTK's double press: same button, close in time and place to the press before, and not a third press
+static bool IsDoublePress(int eventType, const EmscriptenMouseEvent *e)
+{
+    static double lastTime = -1e9;
+    static long lastX = 0, lastY = 0;
+    static int lastButton = -1;
+    static bool lastWasDouble = false;
+    if (eventType != EMSCRIPTEN_EVENT_MOUSEDOWN)
+        return false;
+    const bool isDouble = !lastWasDouble && e->button == lastButton
+        && e->timestamp - lastTime <= wxSystemSettings::GetMetric(wxSYS_DCLICK_MSEC)
+        && std::abs(e->screenX - lastX) <= wxSystemSettings::GetMetric(wxSYS_DCLICK_X)
+        && std::abs(e->screenY - lastY) <= wxSystemSettings::GetMetric(wxSYS_DCLICK_Y);
+    lastTime = e->timestamp; lastX = e->screenX; lastY = e->screenY; lastButton = e->button;
+    lastWasDouble = isDouble;
+    return isDouble;
+}
+
+EM_BOOL MouseCallback(int eventType, const EmscriptenMouseEvent *e, void *userData)
+{
+    const EmscriptenMouseEvent copy = *e;
+    const bool isDouble = IsDoublePress(eventType, e);
+    wxWasmQueueUserInput([=]() {
+        MouseCallbackNow(eventType, &copy, userData);
+        if (isDouble)
+        {
+            // wxGTK: the second press is a DOWN, then the DCLICK (gdk's 2BUTTON_PRESS)
+            wxMouseEvent event;
+            if (EmscriptenMouseEventToWXEvent(eventType, copy, &event))
+            {
+                event.SetEventType(event.GetEventType() == wxEVT_RIGHT_DOWN ? wxEVT_RIGHT_DCLICK
+                                 : event.GetEventType() == wxEVT_MIDDLE_DOWN ? wxEVT_MIDDLE_DCLICK : wxEVT_LEFT_DCLICK);
+                event.m_clickCount = 2;
+                static_cast<wxApp*>(userData)->HandleMouseEvent(&event);
+            }
+        }
+    }, eventType == EMSCRIPTEN_EVENT_MOUSEDOWN);
+    return true;
+}
+
+EM_BOOL TouchCallback(int eventType, const EmscriptenTouchEvent *e, void *userData)
+{
+    wxMouseEvent probe;
+    if (!EmscriptenTouchEventToWXEvent(eventType, *e, &probe))
+        return false;
+    const EmscriptenTouchEvent copy = *e;
+    wxWasmQueueUserInput([=]() { TouchCallbackNow(eventType, &copy, userData);}, eventType == EMSCRIPTEN_EVENT_TOUCHSTART);
+    return true;
+}
+
+EM_BOOL WheelCallback(int eventType, const EmscriptenWheelEvent *e, void *userData)
+{
+    const EmscriptenWheelEvent copy = *e;
+    wxWasmQueueUserInput([=]() { WheelCallbackNow(eventType, &copy, userData); });
+    return true;
+}
+
+EM_BOOL ResizeCallback(int eventType, const EmscriptenUiEvent *e, void *userData)
+{
+    const EmscriptenUiEvent copy = *e;
+    wxWasmQueueInput([=]() { ResizeCallbackNow(eventType, &copy, userData); });
+    return true;
+}
+
+EM_BOOL FocusCallback(int eventType, const EmscriptenFocusEvent *e, void *userData)
+{
+    const EmscriptenFocusEvent copy = *e;
+    wxWasmQueueUserInput([=]() { FocusCallbackNow(eventType, &copy, userData); });
+    return true;
+}
+
+const char *UnloadCallback(int WXUNUSED(eventType),
+                           const void *WXUNUSED(emscriptenEvent),
+                           void *userData)
+{
+    //printf("UnloadCallback\n");
+    wxApp* app = static_cast<wxApp*>(userData);
+
+    // no modal dialog can run inside beforeunload: each one answers Cancel without showing
+    class UnloadModalHook : public wxModalDialogHook
+    {
+    protected:
+        int Enter(wxDialog*) wxOVERRIDE { return wxID_CANCEL; }
+        void Exit(wxDialog*) wxOVERRIDE { }
+    } hook;
+    hook.Register();
+
+    wxCloseEvent event(wxEVT_CLOSE_WINDOW);
+    event.SetCanVeto(true);
+    app->HandleCloseEvent(&event);
+    hook.Unregister();
+
+    return event.GetVeto() ? "veto" : "";
+}
+
+}
+
+void RegisterEmscriptenCallbacks(wxApp* app)
+{
+    EMSCRIPTEN_RESULT result;
+
+    wxWasmListenForPaste();
+
+    result = emscripten_set_keydown_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, app, false, KeyCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_keyup_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, app, false, KeyCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_keypress_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, app, false, KeyCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_mousedown_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, MouseCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_mouseup_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, MouseCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    //result = emscripten_set_click_callback("#canvas", app, false, MouseCallback);
+    //wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    //result = emscripten_set_dblclick_callback("#canvas", app, false, MouseCallback);
+    //wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_mouseenter_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, MouseCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_mouseleave_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, MouseCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_mousemove_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, MouseCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_wheel_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, WheelCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_touchstart_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, TouchCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_touchend_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, TouchCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_touchmove_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, TouchCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_touchcancel_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, app, false, TouchCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_resize_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, app, false, ResizeCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_focus_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, app, false, FocusCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_blur_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, app, false, FocusCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+
+    result = emscripten_set_beforeunload_callback(app, UnloadCallback);
+    wxASSERT(result == EMSCRIPTEN_RESULT_SUCCESS);
+}
