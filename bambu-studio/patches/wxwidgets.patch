+/////////////////////////////////////////////////////////////////////////////
+// Name:        wx/wasm/window.cpp
+// Purpose:     wxWasmWindow implementation
+// Author:      Adam Hilss
+// Copyright:   (c) 2022 Adam Hilss
+// Licence:     LGPL v2
+/////////////////////////////////////////////////////////////////////////////
+
+#include "wx/wxprec.h"
+
+#include "wx/window.h"
+
+#include "wx/app.h"
+#include "wx/caret.h"
+#include "wx/dcclient.h"
+#include "wx/dnd.h"
+#include "wx/log.h"
+#include "wx/menu.h"
+#include "wx/nonownedwnd.h"
+#include "wx/notebook.h"
+#include "wx/statbox.h"
+#include "wx/toplevel.h"
+#include "wx/notebook.h"
+#include "wx/statbox.h"
+#include "wx/toplevel.h"
+#include "wx/notebook.h"
+#include "wx/statbox.h"
+#include "wx/toplevel.h"
+#include "wx/notebook.h"
+#include "wx/statbox.h"
+#include "wx/toplevel.h"
+#include "wx/notebook.h"
+#include "wx/statbox.h"
+#include "wx/toplevel.h"
+#include "wx/notebook.h"
+#include "wx/statbox.h"
+#include "wx/wasm/private/display.h"
+#include "wx/weakref.h"
+
+#include <algorithm>
+#include <vector>
+
+// Windows whose child showed or hid since the last paint (see wxWindowWasm::Show)
+static std::vector< wxWeakRef<wxWindow> > s_relayoutPending;
+
+// Lay out again, top-level window first, every window with a sizer that holds a window that showed or hid.
+void wxWasmDoPendingRelayouts()
+{
+    if (s_relayoutPending.empty())
+        return;
+    std::vector< wxWeakRef<wxWindow> > pending;
+    pending.swap(s_relayoutPending);
+
+    std::vector< std::pair<int, wxWindow*> > chain;   // (depth, window)
+    for (size_t i = 0; i < pending.size(); ++i)
+    {
+        wxWindow *win = pending[i];
+        if (win == NULL || win->IsBeingDeleted())
+            continue;
+        std::vector<wxWindow*> up;
+        for (wxWindow *p = win; p != NULL; p = p->GetParent())
+        {
+            up.push_back(p);
+            if (p->IsTopLevel())
+                break;
+        }
+        for (size_t d = 0; d < up.size(); ++d)
+        {
+            if (up[d]->GetSizer() != NULL)
+                chain.push_back(std::make_pair(int(up.size() - d), up[d]));
+        }
+    }
+    std::sort(chain.begin(), chain.end());
+    chain.erase(std::unique(chain.begin(), chain.end()), chain.end());
+    for (size_t i = 0; i < chain.size(); ++i)
+        chain[i].second->Layout();
+}
+
+#define TRACE_WINDOW wxT("window")
+#define TRACE_PAINT wxT("paint")
+
+wxWindow *g_mouseWindow = NULL;
+
+static wxWindowWasm *gs_focusWindow = NULL;
+static wxWindowWasm *gs_nextFocusWindow = NULL;
+static wxWindowWasm *gs_captureWindow = NULL;
+
+// ----------------------------------------------------------------------------
+// wxWindowWasm
+// ----------------------------------------------------------------------------
+
+// in wxUniv/MSW this class is abstract because it doesn't have DoPopupMenu()
+// method
+#ifdef __WXUNIVERSAL__
+IMPLEMENT_ABSTRACT_CLASS(wxWindowWasm, wxWindowBase)
+#endif // __WXUNIVERSAL__
+
+wxWindowWasm::wxWindowWasm()
+{
+    Init();
+}
+
+wxWindowWasm::wxWindowWasm(wxWindow *parent,
+                           wxWindowID id,
+                           const wxPoint& pos,
+                           const wxSize& size,
+                           long style,
+                           const wxString& name)
+{
+    Init();
+    bool retval = wxWindowWasm::Create(parent, id, pos, size, style, name);
+    wxASSERT_MSG(retval, wxT("error creating window"));
+}
+
+wxWindowWasm::~wxWindowWasm()
+{
+    SendDestroyEvent();
+
+    if (g_mouseWindow == this)
+    {
+        g_mouseWindow = NULL;
+    }
+    if (gs_focusWindow == this)
+    {
+        gs_focusWindow = NULL;
+    }
+    if (gs_nextFocusWindow == this)
+    {
+        gs_nextFocusWindow = NULL;
+    }
+    if (gs_captureWindow == this)
+    {
+        wxFAIL_MSG(wxT("Destroying window with mouse capture"));
+        ReleaseMouse();
+    }
+
+    DestroyChildren();
+}
+
+void wxWindowWasm::Init()
+{
+    m_x = 0;
+    m_y = 0;
+    m_width = 0;
+    m_height = 0;
+
+    m_childNeedsPaint = true;
+    m_selfNeedsPaint = true;
+    m_wasmCreated = false;
+}
+
+bool wxWindowWasm::Create(wxWindow *parent,
+                          wxWindowID id,
+                          const wxPoint& pos,
+                          const wxSize& size,
+                          long style,
+                          const wxString& name)
+{
+    //printf("wxWindowWasm::Create\n");
+    if (!CreateBase(parent, id, pos, size, style, wxDefaultValidator, name))
+    {
+        return false;
+    }
+    m_wasmCreated = true;
+
+    if (parent)
+    {
+        parent->AddChild(this);
+    }
+
+    int x = pos.x;
+    int y = pos.y;
+    if (x == wxDefaultCoord)
+    {
+        x = 0;
+    }
+    if (y == wxDefaultCoord)
+    {
+        y = 0;
+    }
+    int w = WidthDefault(size.x);
+    int h = HeightDefault(size.y);
+    AdjustForParentClientOrigin(x, y, 0);
+    wxWindowWasm::DoMoveWindow(x, y, w, h);   // this class's own, not a derived control's
+
+    // the window hears its size once after creation, as it is when handled (sizers may have resized it by then)
+    CallAfter([this]() {
+        wxSizeEvent event(GetSize(), GetId());
+        event.SetEventObject(this);
+        HandleWindowEvent(event);
+    });
+
+    return true;
+}
+
+void wxWindowWasm::Raise()
+{
+    if (GetParent())
+    {
+        wxWindowList& children = GetParent()->GetChildren();
+        children.DeleteObject(this);
+        children.Append(this);
+    }
+}
+
+void wxWindowWasm::Lower()
+{
+    if (GetParent())
+    {
+        wxWindowList& children = GetParent()->GetChildren();
+        children.DeleteObject(this);
+        children.Insert(this);
+    }
+}
