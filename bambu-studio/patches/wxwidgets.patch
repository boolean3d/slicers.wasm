+
+    // z48: makes tlw the active top-level window (NULL: none), the previous one inactive, posting wxEVT_ACTIVATE to both
+    static void Activate(wxTopLevelWindowWasm *tlw);
+
+    virtual void SetTitle(const wxString &title) wxOVERRIDE;
+    virtual wxString GetTitle() const wxOVERRIDE { return m_title; }
