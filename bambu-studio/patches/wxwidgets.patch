+    wxWindow *GetWindow() const { return m_window; }
+    void SetWindow(wxWindow* win) { m_window = win; }
+
+private:
+    wxString  m_text;
+    wxWindow *m_window;
+    static bool ms_enabled;
+
+    wxDECLARE_ABSTRACT_CLASS(wxToolTip);
+};
