# Out-of-tree fixes to Orca's GUI-side sources, the same way the engine patches libslic3r
# (engine/cmake/OrcaSourcePatches.cmake): the Orca checkout is never modified; a patched copy is
# generated in the build tree and compiled instead of the original. Every replacement must match
# exactly once, so a change in Orca fails the configure step instead of compiling something else.

# orca_gui_patch(<target> <path relative to ORCA_SRC/src> FIND <text> REPLACE <text> [...])
function(orca_gui_patch target rel_path)
    set(orca_file "${ORCA_SRC}/src/${rel_path}")
    set(out_file "${CMAKE_BINARY_DIR}/gui-patched/${rel_path}")
    file(READ "${orca_file}" text)
    math(EXPR n_pairs "(${ARGC} - 2) / 4")
    math(EXPR rest "(${ARGC} - 2) % 4")
    if (n_pairs EQUAL 0 OR NOT rest EQUAL 0)
        message(FATAL_ERROR "orca_gui_patch(${rel_path}): expected FIND <text> REPLACE <text> pairs.")
    endif ()
    math(EXPR last_pair "${n_pairs} - 1")
    foreach (pair RANGE ${last_pair})
        math(EXPR i_find "3 + 4 * ${pair}")
        math(EXPR i_replace "5 + 4 * ${pair}")
        set(find "${ARGV${i_find}}")
        set(replace "${ARGV${i_replace}}")
        string(FIND "${text}" "${find}" first)
        string(FIND "${text}" "${find}" last REVERSE)
        if (first EQUAL -1 OR NOT first EQUAL last)
            message(FATAL_ERROR "Patch for ${orca_file} no longer applies: the text\n  ${find}\nmust occur exactly once.")
        endif ()
        string(REPLACE "${find}" "${replace}" text "${text}")
    endforeach ()
    file(WRITE "${out_file}.tmp"
        "// Patched copy of ${orca_file}, generated by browser-port/browser-build/cmake/PatchedCopies.cmake. Do not edit.\n"
        "#line 1 \"${orca_file}\"\n"
        "${text}")
    file(COPY_FILE "${out_file}.tmp" "${out_file}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out_file}.tmp")
    get_filename_component(orca_dir "${orca_file}" DIRECTORY)
    get_target_property(target_dir ${target} SOURCE_DIR)
    set_source_files_properties("${out_file}" TARGET_DIRECTORY ${target} PROPERTIES INCLUDE_DIRECTORIES "${orca_dir}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${orca_file}")

    # Swap the original for the copy in the target's sources (listed relative or absolute).
    get_target_property(sources ${target} SOURCES)
    set(new_sources)
    set(swapped FALSE)
    foreach (s IN LISTS sources)
        if (IS_ABSOLUTE "${s}")
            set(abs "${s}")
        else ()
            set(abs "${target_dir}/${s}")
        endif ()
        cmake_path(NORMAL_PATH abs)
        if (abs STREQUAL orca_file)
            list(APPEND new_sources "${out_file}")
            set(swapped TRUE)
        else ()
            list(APPEND new_sources "${s}")
        endif ()
    endforeach ()
    if (NOT swapped)
        message(FATAL_ERROR "orca_gui_patch: ${orca_file} is not a source of ${target}.")
    endif ()
    set_property(TARGET ${target} PROPERTY SOURCES ${new_sources})
endfunction()
