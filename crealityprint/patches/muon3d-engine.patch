diff --git a/engine/cmake/OrcaSources.cmake b/engine/cmake/OrcaSources.cmake
index 7763f06..39d6427 100644
--- a/engine/cmake/OrcaSources.cmake
+++ b/engine/cmake/OrcaSources.cmake
@@ -20,6 +20,21 @@ function(orca_libslic3r_sources out_var)
                             "Orca's libslic3r CMakeLists changed; update engine/cmake/OrcaSources.cmake.")
     endif ()
     string(REGEX MATCHALL "[A-Za-z0-9_./-]+\\.cpp" sources "${CMAKE_MATCH_1}")
+    # a fork's further unconditional list(APPEND lisbslic3r_sources ...) blocks, here and in the .cmake files it includes
+    string(REGEX REPLACE "if *\\((WIN32|APPLE)\\)[ \t]*\n[ \t]*list\\(APPEND lisbslic3r_sources[^)]*\\)" "" rest "${text}")
+    string(REGEX MATCHALL "include\\(([A-Za-z0-9_.-]+\\.cmake)\\)" incs "${rest}")
+    foreach (inc IN LISTS incs)
+        string(REGEX REPLACE "include\\(([^)]*)\\)" "\\1" inc "${inc}")
+        file(READ "${ORCA_SRC}/src/libslic3r/${inc}" inc_text)
+        string(REGEX REPLACE "#[^\n]*" "" inc_text "${inc_text}")
+        string(APPEND rest "\n${inc_text}")
+        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ORCA_SRC}/src/libslic3r/${inc}")
+    endforeach ()
+    string(REGEX MATCHALL "list\\(APPEND lisbslic3r_sources[^)]*\\)" appends "${rest}")
+    foreach (block IN LISTS appends)
+        string(REGEX MATCHALL "[A-Za-z0-9_./-]+\\.cpp" more "${block}")
+        list(APPEND sources ${more})
+    endforeach ()
     list(REMOVE_DUPLICATES sources)
     set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${cmake_file}")
     set(${out_var} "${sources}" PARENT_SCOPE)
@@ -39,9 +54,7 @@ set(ORCA_LIBSLIC3R_EXCLUDED
