+// Boolean3d (slicer-wx app-edits/z70): a part Boolean3d made opens on the person's own printer (see the edit's text).
+namespace Slic3r { namespace GUI {
+static bool b3d_part_file(const std::string &path)
+{
+    // Boolean3d writes 3D/3dmodel.bambu beside 3D/3dmodel.model; a slicer saving the project does not.
+    if (!boost::iends_with(path, ".3mf")) return false;
+    mz_zip_archive zip;
+    mz_zip_zero_struct(&zip);
+    if (!open_zip_reader(&zip, path)) return false;
+    const bool ours = mz_zip_reader_locate_file(&zip, "3D/3dmodel.bambu", nullptr, 0) >= 0;
+    close_zip_reader(&zip);
+    return ours;
+}
+// Plater's "filament count changed" is on_filaments_change in the forks, on_filament_count_change in OrcaSlicer.
+// Boolean3d (slicer-wx app-edits/z70) step 2: set when a part Boolean3d made was opened, read once by load_project.
+static bool b3d_part_unsaved = false;
+// The title's "changed" mark: update_title_dirty_status in most forks, absent in Creality Print.
+template<class P> static auto b3d_title_dirty(P *p, int) -> decltype(p->update_title_dirty_status(), void()) { p->update_title_dirty_status(); }
+template<class P> static void b3d_title_dirty(P *, long) {}
+template<class P> static auto b3d_filaments_changed(P *p, size_t n, int) -> decltype(p->on_filaments_change(n), void()) { p->on_filaments_change(n); }
+template<class P> static void b3d_filaments_changed(P *p, size_t n, long) { p->on_filament_count_change(n); }
+} }
